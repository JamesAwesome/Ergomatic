+      }
+    } else if (c2 !== null) {
+      allRuns.push(c2);
+      c2 = null;
+    }
+  }
+  if (c2 !== null) allRuns.push(c2);
+  lines.push(`rest runs over ALL samples: ${allRuns.length}`);
+  for (const [i, r] of allRuns.entries()) {
+    lines.push(
+      `  run ${i + 1}: t ${r.from.toFixed(1)}..${r.to.toFixed(1)} s ` +
+        `(${(r.to - r.from).toFixed(1)} s, ${r.n} samples)`,
+    );
+  }
+
+  // The longest flat span in `t` between consecutive samples, and the
+  // longest run of samples whose `d` does not move (a stop the axis
+  // cannot show).
+  let maxGap = 0;
+  let maxGapAt = 0;
+  for (let i = 1; i < s.length; i++) {
+    const g = (s[i]!.t - s[i - 1]!.t) / 10;
+    if (g > maxGap) {
+      maxGap = g;
+      maxGapAt = s[i - 1]!.t / 10;
+    }
+  }
+  lines.push(`largest gap between consecutive samples: ${maxGap.toFixed(2)} s at t=${maxGapAt.toFixed(1)}`);
+  let flatBest = 0;
+  let flatFrom = 0;
+  let runFrom = 0;
+  for (let i = 1; i < s.length; i++) {
+    if (Math.abs(s[i]!.d - s[runFrom]!.d) < 1) {
+      const span = (s[i]!.t - s[runFrom]!.t) / 10;
+      if (span > flatBest) {
+        flatBest = span;
+        flatFrom = s[runFrom]!.t / 10;
+      }
+    } else {
+      runFrom = i;
+    }
+  }
+  lines.push(`longest flat-distance span: ${flatBest.toFixed(2)} s from t=${flatFrom.toFixed(1)}`);
+  return lines.join("\n");
+}
