+/** `docs/monitor/sessions/walk-2026-08-25/README.md`'s own provenance row:
+ *  "Walk Rests (`w 1' r1 / w 500m r1 / w 1'`)" — two EQUAL 60 s rests. */
+const RESTS_FINISHED_PROGRAM: WorkoutProgram = {
+  intervals: [
+    { type: "work", kind: "time", value: 60, targetSplit: 129, displaySpm: null, restSeconds: 60 },
+    { type: "work", kind: "distance", value: 500, targetSplit: 129, displaySpm: null, restSeconds: 60 },
+    { type: "work", kind: "time", value: 60, targetSplit: 129, displaySpm: null, restSeconds: 0 },
+  ],
+};
