new file mode 100644
index 0000000000000000000000000000000000000000..c8ee55a936da2478a9c138a119c1e9cf75c46a73
--- /dev/null
+++ b/ios/Sources/NfcPlugin/NfcSessionCoordinator.swift
@@ -0,0 +1,80 @@
+import Foundation
+
+final class NfcSessionCoordinator {
+    let queue = DispatchQueue(label: "app.capgo.nfc.session")
+
+    private let contextKey = DispatchSpecificKey<UUID>()
+    private let contextIdentifier = UUID()
+    private var state = NdefAttemptState()
+
+    init() {
+        queue.setSpecific(key: contextKey, value: contextIdentifier)
+    }
+
+    var isCurrentContext: Bool {
+        DispatchQueue.getSpecific(key: contextKey) == contextIdentifier
+    }
+
+    func assertCurrentContext() {
+        dispatchPrecondition(condition: .onQueue(queue))
+    }
+
+    func async(_ work: @escaping () -> Void) {
+        queue.async(execute: work)
+    }
+
+    var draining: NdefAttemptKey? {
+        assertCurrentContext()
+        return state.draining
+    }
+
+    var beginCandidate: String? {
+        assertCurrentContext()
+        return state.beginCandidate
+    }
+
+    var beginCandidateKind: NfcSessionKind? {
+        assertCurrentContext()
+        return state.beginCandidateKind
+    }
+
+    func requestStart(attemptId: String) throws -> NdefStartDecision {
+        assertCurrentContext()
+        return try state.requestStart(attemptId: attemptId)
+    }
+
+    func requestStart(attemptId: String, kind: NfcSessionKind) throws -> NdefStartDecision {
+        assertCurrentContext()
+        return try state.requestStart(attemptId: attemptId, kind: kind)
+    }
+
+    func activate(attemptId: String, session: AnyObject) throws -> NdefAttemptKey {
+        assertCurrentContext()
+        return try state.activate(attemptId: attemptId, session: session)
+    }
+
+    func activate(attemptId: String, kind: NfcSessionKind, session: AnyObject) throws -> NdefAttemptKey {
+        assertCurrentContext()
+        return try state.activate(attemptId: attemptId, kind: kind, session: session)
+    }
+
+    func accepts(_ key: NdefAttemptKey) -> Bool {
+        assertCurrentContext()
+        return state.accepts(key)
+    }
+
+    func replaceActiveSession(_ key: NdefAttemptKey, session: AnyObject) -> NdefAttemptKey? {
+        assertCurrentContext()
+        return state.replaceActiveSession(key, session: session)
+    }
+
+    func requestStop(attemptId: String) -> NdefStopDecision {
+        assertCurrentContext()
+        return state.requestStop(attemptId: attemptId)
+    }
+
+    func finishInvalidation(_ key: NdefAttemptKey) -> String? {
+        assertCurrentContext()
+        return state.finishInvalidation(key)
+    }
+}
diff --git a/ios/Tests/NfcPluginTests/NdefAttemptStateTests.swift b/ios/Tests/NfcPluginTests/NdefAttemptStateTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..be52faa1612f4b288e114f3964dd8560ce5bca8e
--- /dev/null
+++ b/ios/Tests/NfcPluginTests/NdefAttemptStateTests.swift
@@ -0,0 +1,190 @@
+import XCTest
+@testable import NfcPlugin
+
+final class NdefAttemptStateTests: XCTestCase {
+    func testCoordinatorSerializesConcurrentCrossTypeTransitions() {
+        let coordinator = NfcSessionCoordinator()
+        let ready = expectation(description: "all coordinator operations finish")
+        ready.expectedFulfillmentCount = 3
+        let stateLock = NSLock()
+        var completedOnCoordinator = [Bool]()
+
+        for index in 0..<3 {
+            DispatchQueue.global().async {
+                coordinator.async {
+                    let onCoordinator = coordinator.isCurrentContext
+                    stateLock.lock()
+                    completedOnCoordinator.append(onCoordinator)
+                    stateLock.unlock()
+                    guard onCoordinator else {
+                        ready.fulfill()
+                        return
+                    }
+
+                    let firstSession = NSObject()
+                    let secondSession = NSObject()
+                    let firstKind: NfcSessionKind = index.isMultiple(of: 2) ? .ndef : .tag
+                    let secondKind: NfcSessionKind = firstKind == .ndef ? .tag : .ndef
+                    let firstAttempt = "attempt-\(index)-a"
+                    let secondAttempt = "attempt-\(index)-b"
+                    XCTAssertEqual(
+                        try? coordinator.requestStart(attemptId: firstAttempt, kind: firstKind),
+                        .begin(firstAttempt)
+                    )
+                    let firstKey = try? coordinator.activate(
+                        attemptId: firstAttempt,
+                        kind: firstKind,
+                        session: firstSession
+                    )
+                    XCTAssertNotNil(firstKey)
+                    if let firstKey {
+                        XCTAssertEqual(
+                            try? coordinator.requestStart(attemptId: secondAttempt, kind: secondKind),
+                            .invalidate(firstKey)
+                        )
+                        XCTAssertEqual(coordinator.finishInvalidation(firstKey), secondAttempt)
+                        let secondKey = try? coordinator.activate(
+                            attemptId: secondAttempt,
+                            kind: secondKind,
+                            session: secondSession
+                        )
+                        XCTAssertNotNil(secondKey)
+                        if let secondKey {
+                            XCTAssertEqual(
+                                coordinator.requestStop(attemptId: secondAttempt),
+                                .invalidate(secondKey)
+                            )
+                            XCTAssertNil(coordinator.finishInvalidation(secondKey))
+                        }
+                    }
+                    ready.fulfill()
+                }
+            }
+        }
+
+        wait(for: [ready], timeout: 2)
+        XCTAssertEqual(completedOnCoordinator, [true, true, true])
+    }
+
+    func testBWaitsForAAndLateACannotClearB() throws {
+        let aSession = NSObject()
+        let bSession = NSObject()
+        var state = NdefAttemptState()
+
+        XCTAssertEqual(try state.requestStart(attemptId: "attempt-a"), .begin("attempt-a"))
+        let a = try state.activate(attemptId: "attempt-a", session: aSession)
+        XCTAssertTrue(state.accepts(a))
+
+        XCTAssertEqual(try state.requestStart(attemptId: "attempt-b"), .invalidate(a))
+        XCTAssertFalse(state.accepts(a))
+        XCTAssertEqual(state.finishInvalidation(a), "attempt-b")
+
+        let b = try state.activate(attemptId: "attempt-b", session: bSession)
+        XCTAssertTrue(state.accepts(b))
+        XCTAssertNil(state.finishInvalidation(a))
+        XCTAssertTrue(state.accepts(b))
+        XCTAssertEqual(state.requestStop(attemptId: "attempt-a"), .alreadyDrained)
+        XCTAssertTrue(state.accepts(b))
+    }
+
+    func testStopSettlesOnlyAfterMatchingInvalidation() throws {
+        let session = NSObject()
+        var state = NdefAttemptState()
+        XCTAssertEqual(try state.requestStart(attemptId: "attempt-a"), .begin("attempt-a"))
+        let a = try state.activate(attemptId: "attempt-a", session: session)
+
+        XCTAssertEqual(state.requestStop(attemptId: "attempt-a"), .invalidate(a))
+        XCTAssertFalse(state.accepts(a))
+        XCTAssertNil(state.finishInvalidation(
+            NdefAttemptKey(attemptId: "attempt-a", generation: a.generation + 1, sessionIdentifier: a.sessionIdentifier)
+        ))
+        XCTAssertEqual(state.finishInvalidation(a), nil)
+        XCTAssertEqual(state.requestStop(attemptId: "attempt-a"), .alreadyDrained)
+    }
+
+    func testStopCancelsBWhileBIsQueuedBehindA() throws {
+        let session = NSObject()
+        var state = NdefAttemptState()
+        XCTAssertEqual(try state.requestStart(attemptId: "attempt-a"), .begin("attempt-a"))
+        let a = try state.activate(attemptId: "attempt-a", session: session)
+        XCTAssertEqual(try state.requestStart(attemptId: "attempt-b"), .invalidate(a))
+
+        XCTAssertEqual(state.requestStop(attemptId: "attempt-b"), .cancelPending)
+        XCTAssertNil(state.finishInvalidation(a))
+    }
+
+    func testRejectsMissingAttemptIdAndNonSingletonTagCounts() {
+        var state = NdefAttemptState()
+        XCTAssertThrowsError(try state.requestStart(attemptId: ""))
+        XCTAssertFalse(isExactlyOneDetectedTag(count: 0))
+        XCTAssertTrue(isExactlyOneDetectedTag(count: 1))
+        XCTAssertFalse(isExactlyOneDetectedTag(count: 2))
+    }
+
+    func testTagStopKeepsOwnershipDrainingUntilItsMatchingInvalidation() throws {
+        let session = NSObject()
+        var state = NdefAttemptState()
+
+        XCTAssertEqual(try state.requestStart(attemptId: "tag-a", kind: .tag), .begin("tag-a"))
+        let tagA = try state.activate(attemptId: "tag-a", kind: .tag, session: session)
+        XCTAssertTrue(state.accepts(tagA))
+
+        XCTAssertEqual(state.requestStop(attemptId: "tag-a"), .invalidate(tagA))
+        XCTAssertFalse(state.accepts(tagA))
+        XCTAssertNil(state.finishInvalidation(
+            NdefAttemptKey(
+                attemptId: "tag-a",
+                generation: tagA.generation + 1,
+                sessionIdentifier: tagA.sessionIdentifier,
+                kind: .tag
+            )
+        ))
+        XCTAssertNil(state.finishInvalidation(tagA))
+        XCTAssertFalse(state.accepts(tagA))
+    }
+
+    func testLateTagInvalidationCannotClearTagReplacement() throws {
+        let aSession = NSObject()
+        let bSession = NSObject()
+        var state = NdefAttemptState()
+
+        XCTAssertEqual(try state.requestStart(attemptId: "tag-a", kind: .tag), .begin("tag-a"))
+        let tagA = try state.activate(attemptId: "tag-a", kind: .tag, session: aSession)
+        XCTAssertEqual(try state.requestStart(attemptId: "tag-b", kind: .tag), .invalidate(tagA))
+        XCTAssertEqual(state.finishInvalidation(tagA), "tag-b")
+
+        let tagB = try state.activate(attemptId: "tag-b", kind: .tag, session: bSession)
+        XCTAssertTrue(state.accepts(tagB))
+        XCTAssertNil(state.finishInvalidation(tagA))
+        XCTAssertTrue(state.accepts(tagB))
+    }
+
+    func testNdefStartQueuesBehindDrainingTagSession() throws {
+        let tagSession = NSObject()
+        let ndefSession = NSObject()
+        var state = NdefAttemptState()
+
+        XCTAssertEqual(try state.requestStart(attemptId: "tag-a", kind: .tag), .begin("tag-a"))
+        let tagA = try state.activate(attemptId: "tag-a", kind: .tag, session: tagSession)
+
+        XCTAssertEqual(try state.requestStart(attemptId: "ndef-b", kind: .ndef), .invalidate(tagA))
+        XCTAssertFalse(state.accepts(tagA))
+        XCTAssertEqual(state.finishInvalidation(tagA), "ndef-b")
+
+        let ndefB = try state.activate(attemptId: "ndef-b", kind: .ndef, session: ndefSession)
+        XCTAssertTrue(state.accepts(ndefB))
+    }
+
+    func testStopWithReusedAttemptIdWaitsForDrainingGeneration() throws {
+        let session = NSObject()
+        var state = NdefAttemptState()
+
+        XCTAssertEqual(try state.requestStart(attemptId: "attempt-a"), .begin("attempt-a"))
+        let a = try state.activate(attemptId: "attempt-a", session: session)
+        XCTAssertEqual(try state.requestStart(attemptId: "attempt-a"), .invalidate(a))
+
+        XCTAssertEqual(state.requestStop(attemptId: "attempt-a"), .awaitInvalidation(a))
+        XCTAssertNil(state.finishInvalidation(a))
+        XCTAssertEqual(state.requestStop(attemptId: "attempt-a"), .alreadyDrained)
+    }
+}
diff --git a/ios/Tests/NfcPluginTests/NdefSessionEndingTests.swift b/ios/Tests/NfcPluginTests/NdefSessionEndingTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..7940ac0a6a97b2d1fb18b5a9cf2e75aee47dd01a
--- /dev/null
+++ b/ios/Tests/NfcPluginTests/NdefSessionEndingTests.swift
@@ -0,0 +1,361 @@
+import Capacitor
+import CoreNFC
+import Foundation
+import XCTest
+
+@testable import NfcPlugin
+
+/// Native-injected tests for the two Gate -1 criteria that no physical
+/// presentation can exercise deterministically: the controller's own
+/// single-tag count check on the delegate's tag array (criterion 8) and the
+/// reader-ending semantics the JS layer receives (criterion 7). iOS is not in
+/// the loop: the test plays Core NFC, delivering delegate callbacks to the
+/// production plugin over a no-radio session double and reading what the
+/// plugin publishes to its listeners.
+private func coreNfc(_ code: Int) -> NSError {
+    NSError(domain: NFCReaderError.errorDomain, code: code)
+}
+
+private func ndefMessage() -> NFCNDEFMessage {
+    NFCNDEFMessage(records: [
+        NFCNDEFPayload(format: .nfcWellKnown, type: Data("T".utf8), identifier: Data(), payload: Data([0x02, 0x65, 0x6E]))
+    ])
+}
+
+final class NdefSessionEndingTests: XCTestCase {
+    private let oneTagMessage = "Present exactly one NFC tag."
+
+    private struct Ending: Equatable {
+        let attemptId: String?
+        let reason: String?
+        var cause: String? = nil
+        var keys: Set<String> = ["attemptId", "reason"]
+    }
+
+    private func recordEndings(_ plugin: NfcPlugin, into endings: @escaping (Ending) -> Void) {
+        listen(plugin, event: "nfcSessionEnd") { payload in
+            endings(Ending(
+                attemptId: payload["attemptId"] as? String,
+                reason: payload["reason"] as? String,
+                cause: payload["cause"] as? String,
+                keys: Set(payload.keys)
+            ))
+        }
+    }
+
+    private func forced(_ attemptId: String, _ cause: String) -> Ending {
+        Ending(attemptId: attemptId, reason: "invalidated", cause: cause, keys: ["attemptId", "reason", "cause"])
+    }
+
+    // MARK: - Criterion 8: zero or multiple physical tags are rejected by us
+
+    func testTwoDetectedTagsAreRejectedBeforeAnyConnect() {
+        let plugin = NfcProbePlugin()
+        var events: [[String: Any]] = []
+        listen(plugin, event: "nfcEvent") { events.append($0) }
+        wait(for: [startNdef(plugin, attemptId: "A")], timeout: 1)
+        let session = plugin.sessions[0]
+
+        plugin.onSessionQueue {
+            plugin.readerSessionDidBecomeActive(session)
+            plugin.readerSession(session, didDetect: [NfcFakeNdefTag(), NfcFakeNdefTag()])
+        }
+        settleMainQueue()
+
+        XCTAssertEqual(session.invalidationMessages, [oneTagMessage])
+        XCTAssertEqual(session.connectCount, 0)
+        XCTAssertEqual(session.plainInvalidateCount, 0)
+        XCTAssertTrue(events.isEmpty)
+    }
+
+    func testZeroDetectedTagsAreRejectedBeforeAnyConnect() {
+        let plugin = NfcProbePlugin()
+        var events: [[String: Any]] = []
+        listen(plugin, event: "nfcEvent") { events.append($0) }
+        wait(for: [startNdef(plugin, attemptId: "A")], timeout: 1)
+        let session = plugin.sessions[0]
+
+        plugin.onSessionQueue {
+            plugin.readerSession(session, didDetect: [])
+        }
+        settleMainQueue()
+
+        XCTAssertEqual(session.invalidationMessages, [oneTagMessage])
+        XCTAssertEqual(session.connectCount, 0)
+        XCTAssertTrue(events.isEmpty)
+    }
+
+    func testMultipleNdefMessagesAreRejectedWhileOneIsPublished() {
+        let plugin = NfcProbePlugin()
+        var events: [[String: Any]] = []
+        listen(plugin, event: "nfcEvent") { events.append($0) }
+        wait(for: [startNdef(plugin, attemptId: "A")], timeout: 1)
+        let session = plugin.sessions[0]
+
+        plugin.onSessionQueue {
+            plugin.readerSession(session, didDetectNDEFs: [ndefMessage(), ndefMessage()])
+        }
+        settleMainQueue()
+        XCTAssertEqual(session.invalidationMessages, [oneTagMessage])
+        XCTAssertTrue(events.isEmpty)
+
+        // The rejection put A into drain, so a single message can no longer
+        // be attributed to it; start B and prove the one-message path publishes.
+        plugin.onSessionQueue {
+            plugin.readerSession(session, didInvalidateWithError: coreNfc(200))
+        }
+        wait(for: [startNdef(plugin, attemptId: "B")], timeout: 1)
+        let sessionB = plugin.sessions[1]
+        plugin.onSessionQueue {
+            plugin.readerSession(sessionB, didDetectNDEFs: [ndefMessage()])
+        }
+        settleMainQueue()
+
+        XCTAssertEqual(events.count, 1)
+        XCTAssertEqual(events.first?["attemptId"] as? String, "B")
+        XCTAssertEqual(events.first?["type"] as? String, "ndef")
+        XCTAssertTrue(sessionB.invalidationMessages.isEmpty)
+    }
+
+    func testRejectedAttemptDrainsAndCannotTouchItsSuccessor() {
+        let plugin = NfcProbePlugin()
+        var endings: [Ending] = []
+        var events: [[String: Any]] = []
+        recordEndings(plugin) { endings.append($0) }
+        listen(plugin, event: "nfcEvent") { events.append($0) }
+        wait(for: [startNdef(plugin, attemptId: "A")], timeout: 1)
+        let sessionA = plugin.sessions[0]
+
+        plugin.onSessionQueue {
+            plugin.readerSession(sessionA, didDetect: [NfcFakeNdefTag(), NfcFakeNdefTag()])
+        }
+        // Stop requested while A is already draining resolves only once iOS
+        // reports A's invalidation, never before.
+        let stop = stopNdef(plugin, attemptId: "A")
+        plugin.onSessionQueue {}
+        XCTAssertFalse(stop.isSettled())
+
+        plugin.onSessionQueue {
+            plugin.readerSession(sessionA, didInvalidateWithError: coreNfc(200))
+        }
+        wait(for: [stop.settled], timeout: 1)
+        settleMainQueue()
+        XCTAssertEqual(endings.map(\.attemptId), ["A"])
+
+        wait(for: [startNdef(plugin, attemptId: "B")], timeout: 1)
+        let sessionB = plugin.sessions[1]
+        XCTAssertEqual(plugin.sessions.count, 2)
+
+        // Late A callbacks of every kind: a single tag, a second ending.
+        plugin.onSessionQueue {
+            plugin.readerSession(sessionA, didDetect: [NfcFakeNdefTag()])
+            plugin.readerSession(sessionA, didInvalidateWithError: coreNfc(202))
+        }
+        settleMainQueue()
+        XCTAssertEqual(sessionA.connectCount, 0)
+        XCTAssertEqual(endings.map(\.attemptId), ["A"])
+        XCTAssertTrue(events.isEmpty)
+
+        // B is untouched: its single tag still connects and its ending is its own.
+        plugin.onSessionQueue {
+            plugin.readerSession(sessionB, didDetect: [NfcFakeNdefTag()])
+        }
+        XCTAssertEqual(sessionB.connectCount, 1)
+        XCTAssertTrue(sessionB.invalidationMessages.isEmpty)
+        plugin.onSessionQueue {
+            plugin.readerSession(sessionB, didInvalidateWithError: coreNfc(201))
+        }
+        settleMainQueue()
+        XCTAssertEqual(endings, [
+            forced("A", "multipleTags"),
+            Ending(attemptId: "B", reason: "sessionTimeout")
+        ])
+    }
+
+    // MARK: - Criterion 7: reader-ending semantics as the JS layer receives them
+
+    func testCoreNfcInvalidationCodesMapToEndingReasonsWithAttemptIdentity() {
+        // Independent literals from the CoreNFC SDK header (NFCError.h):
+        // 200 UserCanceled, 201 SessionTimeout, 202 SessionTerminatedUnexpectedly,
+        // 203 SystemIsBusy. Not derived from NFCReaderError so a remapped
+        // constant cannot retune the test with it.
+        let cases: [(code: Int, reason: String)] = [
+            (200, "userCancelled"),
+            (201, "sessionTimeout"),
+            (202, "invalidated"),
+            (203, "invalidated")
+        ]
+
+        for (code, reason) in cases {
+            let plugin = NfcProbePlugin()
+            var endings: [Ending] = []
+            recordEndings(plugin) { endings.append($0) }
+            let attemptId = "attempt-\(code)"
+            wait(for: [startNdef(plugin, attemptId: attemptId)], timeout: 1)
+            let session = plugin.sessions[0]
+
+            plugin.onSessionQueue {
+                plugin.readerSessionDidBecomeActive(session)
+                plugin.readerSession(session, didInvalidateWithError: coreNfc(code))
+            }
+            settleMainQueue()
+
+            XCTAssertEqual(endings, [Ending(attemptId: attemptId, reason: reason)], "code \(code)")
+            // The attempt is drained: a stop for it settles immediately.
+            wait(for: [stopNdef(plugin, attemptId: attemptId).settled], timeout: 1)
+        }
+    }
+
+    func testFirstNdefTagReadInvalidationEndsSilently() {
+        // 204 FirstNDEFTagRead: the session closed itself after a successful
+        // read. The plugin publishes no ending and no state change for it.
+        let plugin = NfcProbePlugin()
+        var endings: [Ending] = []
+        var stateChanges = 0
+        recordEndings(plugin) { endings.append($0) }
+        listen(plugin, event: "nfcStateChange") { _ in stateChanges += 1 }
+        wait(for: [startNdef(plugin, attemptId: "A")], timeout: 1)
+        let session = plugin.sessions[0]
+
+        plugin.onSessionQueue {
+            plugin.readerSession(session, didInvalidateWithError: coreNfc(204))
+        }
+        settleMainQueue()
+
+        XCTAssertTrue(endings.isEmpty)
+        XCTAssertEqual(stateChanges, 0)
+        wait(for: [stopNdef(plugin, attemptId: "A").settled], timeout: 1)
+        XCTAssertEqual(session.plainInvalidateCount, 0)
+    }
+
+    // MARK: - The controller publishes why IT ended a session (spec, "Reader-ending seam", option A)
+
+    func testMultipleTagRejectionsPublishTheirCauseWhateverCodeCoreNfcDelivers() {
+        // Programmatic invalidation is reported by Core NFC as 200, the Cancel
+        // code (captures v7/v8). The cause the controller recorded wins over
+        // the code, for every code it could plausibly deliver.
+        struct Rejection { let name: String; let deliver: (NfcProbePlugin, NfcFakeNdefSession) -> Void }
+        let rejections: [Rejection] = [
+            Rejection(name: "two tags") { plugin, session in
+                plugin.readerSession(session, didDetect: [NfcFakeNdefTag(), NfcFakeNdefTag()])
+            },
+            Rejection(name: "zero tags") { plugin, session in
+                plugin.readerSession(session, didDetect: [])
+            },
+            Rejection(name: "two messages") { plugin, session in
+                plugin.readerSession(session, didDetectNDEFs: [ndefMessage(), ndefMessage()])
+            }
+        ]
+        for rejection in rejections {
+            for code in [200, 202] {
+                let plugin = NfcProbePlugin()
+                var endings: [Ending] = []
+                recordEndings(plugin) { endings.append($0) }
+                wait(for: [startNdef(plugin, attemptId: "A")], timeout: 1)
+                let session = plugin.sessions[0]
+                plugin.onSessionQueue {
+                    rejection.deliver(plugin, session)
+                    plugin.readerSession(session, didInvalidateWithError: coreNfc(code))
+                }
+                settleMainQueue()
+                XCTAssertEqual(endings, [forced("A", "multipleTags")], "\(rejection.name), code \(code)")
+            }
+        }
+    }
+
+    func testTagFailuresPublishTagFailureCause() {
+        struct Failure { let name: String; let tag: NfcFakeNdefTag; let connectError: Error?; let prefix: String }
+        let failures: [Failure] = [
+            Failure(name: "connect", tag: NfcFakeNdefTag(), connectError: coreNfc(100), prefix: "Failed to connect to the tag:"),
+            Failure(name: "query", tag: NfcFakeNdefTag(queryError: coreNfc(101)), connectError: nil, prefix: "Failed to read tag status:")
+        ]
+        for failure in failures {
+            let plugin = NfcProbePlugin()
+            var endings: [Ending] = []
+            recordEndings(plugin) { endings.append($0) }
+            wait(for: [startNdef(plugin, attemptId: "A")], timeout: 1)
+            let session = plugin.sessions[0]
+
+            plugin.onSessionQueue {
+                plugin.readerSession(session, didDetect: [failure.tag])
+                session.finishConnect(failure.connectError)
+            }
+            XCTAssertEqual(session.invalidationMessages.count, 1, failure.name)
+            XCTAssertTrue(session.invalidationMessages.first?.hasPrefix(failure.prefix) == true, failure.name)
+
+            plugin.onSessionQueue {
+                plugin.readerSession(session, didInvalidateWithError: coreNfc(200))
+            }
+            settleMainQueue()
+            XCTAssertEqual(endings, [forced("A", "tagFailure")], failure.name)
+        }
+    }
+
+    func testEndingsTheControllerDidNotForceCarryNoCause() {
+        // Includes a Cancel (200) that follows a plain stop: still no cause.
+        let plugin = NfcProbePlugin()
+        var endings: [Ending] = []
+        recordEndings(plugin) { endings.append($0) }
+        wait(for: [startNdef(plugin, attemptId: "A")], timeout: 1)
+        let session = plugin.sessions[0]
+        let stop = stopNdef(plugin, attemptId: "A")
+        plugin.onSessionQueue {
+            plugin.readerSession(session, didInvalidateWithError: coreNfc(200))
+        }
+        wait(for: [stop.settled], timeout: 1)
+        settleMainQueue()
+        XCTAssertEqual(endings, [Ending(attemptId: "A", reason: "userCancelled")])
+        XCTAssertEqual(endings.first?.keys, ["attemptId", "reason"])
+    }
+
+    func testForcedCauseIsConsumedByItsOwnEndingAndCannotReachAReusedAttemptId() {
+        let plugin = NfcProbePlugin()
+        var endings: [Ending] = []
+        recordEndings(plugin) { endings.append($0) }
+        wait(for: [startNdef(plugin, attemptId: "same")], timeout: 1)
+        let first = plugin.sessions[0]
+        plugin.onSessionQueue {
+            plugin.readerSession(first, didDetect: [NfcFakeNdefTag(), NfcFakeNdefTag()])
+            plugin.readerSession(first, didInvalidateWithError: coreNfc(200))
+        }
+        settleMainQueue()
+        XCTAssertEqual(endings, [forced("same", "multipleTags")])
+
+        wait(for: [startNdef(plugin, attemptId: "same")], timeout: 1)
+        let second = plugin.sessions[1]
+        plugin.onSessionQueue {
+            plugin.readerSession(second, didInvalidateWithError: coreNfc(201))
+        }
+        settleMainQueue()
+        XCTAssertEqual(endings, [
+            forced("same", "multipleTags"),
+            Ending(attemptId: "same", reason: "sessionTimeout")
+        ])
+    }
+
+    func testStopOfLiveAttemptInvalidatesOnceAndSettlesOnlyOnItsOwnEnding() {
+        let plugin = NfcProbePlugin()
+        var endings: [Ending] = []
+        recordEndings(plugin) { endings.append($0) }
+        wait(for: [startNdef(plugin, attemptId: "A")], timeout: 1)
+        let session = plugin.sessions[0]
+
+        let stop = stopNdef(plugin, attemptId: "A")
+        plugin.onSessionQueue {}
+        XCTAssertFalse(stop.isSettled())
+        XCTAssertEqual(session.plainInvalidateCount, 1)
+        XCTAssertTrue(session.invalidationMessages.isEmpty)
+
+        // A stop for a different attempt never settles A's stop.
+        wait(for: [stopNdef(plugin, attemptId: "other").settled], timeout: 1)
+        XCTAssertFalse(stop.isSettled())
+
+        plugin.onSessionQueue {
+            plugin.readerSession(session, didInvalidateWithError: coreNfc(200))
+        }
+        wait(for: [stop.settled], timeout: 1)
+        settleMainQueue()
+        XCTAssertEqual(endings, [Ending(attemptId: "A", reason: "userCancelled")])
+        XCTAssertEqual(session.plainInvalidateCount, 1)
+    }
+}
diff --git a/ios/Tests/NfcPluginTests/NfcDiagnosticTraceTests.swift b/ios/Tests/NfcPluginTests/NfcDiagnosticTraceTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..0dd2ba8041d6098327efcdaca6a7d4ec2b743de7
--- /dev/null
+++ b/ios/Tests/NfcPluginTests/NfcDiagnosticTraceTests.swift
@@ -0,0 +1,164 @@
+import Capacitor
+import CoreNFC
+import Foundation
+import XCTest
+
+@testable import NfcPlugin
+
+final class NfcDiagnosticTraceTests: XCTestCase {
+
+    private final class ProbeDelegate: NSObject, NFCNDEFReaderSessionDelegate {
+        func readerSession(_ session: NFCNDEFReaderSession, didInvalidateWithError error: Error) {}
+        func readerSession(_ session: NFCNDEFReaderSession, didDetect tags: [NFCNDEFTag]) {}
+        func readerSession(_ session: NFCNDEFReaderSession, didDetectNDEFs messages: [NFCNDEFMessage]) {}
+    }
+
+    func testNoRadioNdefSessionDoubleCanBeConstructedWithoutBeginning() {
+        let session = NfcFakeNdefSession(
+            delegate: ProbeDelegate(),
+            queue: DispatchQueue(label: "NfcDiagnosticTraceTests"),
+            invalidateAfterFirstRead: false
+        )
+        XCTAssertNotNil(session)
+    }
+
+    func testActualNdefDelegateEmitsActivationAndConnectError() {
+        var messages: [String] = []
+        let plugin = NfcProbePlugin()
+        plugin.diagnosticTrace = NfcDiagnosticTrace(now: { 11 }, sink: { messages.append($0) })
+
+        let resolved = startNdef(plugin, attemptId: "A")
+        wait(for: [resolved], timeout: 1)
+        let session = try! XCTUnwrap(plugin.sessions.first)
+
+        plugin.onSessionQueue {
+            plugin.readerSessionDidBecomeActive(session)
+            plugin.readerSession(session, didDetect: [NfcFakeNdefTag()])
+            session.finishConnect(NSError(domain: NFCReaderError.errorDomain, code: 77))
+        }
+
+        XCTAssertEqual(messages.count, 4)
+        XCTAssertTrue(messages[0].contains("\"event\":\"ndef.begin.initiated\""))
+        XCTAssertTrue(messages[1].contains("\"event\":\"ndef.begin.returned\""))
+        XCTAssertTrue(messages[2].contains("\"event\":\"ndef.rf.active\""))
+        XCTAssertTrue(messages[3].contains("\"event\":\"ndef.error\""))
+        XCTAssertTrue(messages[3].contains("\"operation\":\"connect\""))
+        XCTAssertTrue(messages[3].contains("\"code\":77"))
+    }
+
+    func testActualNdefDelegateEmitsQueryAndReadErrors() {
+        let cases: [(String, NfcFakeNdefTag, Int)] = [
+            ("query", NfcFakeNdefTag(queryError: NSError(domain: NFCReaderError.errorDomain, code: 78)), 78),
+            ("read", NfcFakeNdefTag(readError: NSError(domain: NFCReaderError.errorDomain, code: 79)), 79)
+        ]
+
+        for (operation, tag, code) in cases {
+            var messages: [String] = []
+            let plugin = NfcProbePlugin()
+            plugin.diagnosticTrace = NfcDiagnosticTrace(now: { 11 }, sink: { messages.append($0) })
+            let resolved = startNdef(plugin, attemptId: operation)
+            wait(for: [resolved], timeout: 1)
+            let session = try! XCTUnwrap(plugin.sessions.first)
+
+            plugin.onSessionQueue {
+                plugin.readerSession(session, didDetect: [tag])
+                session.finishConnect(nil)
+            }
+
+            XCTAssertTrue(messages.last?.contains("\"event\":\"ndef.error\"") == true)
+            XCTAssertTrue(messages.last?.contains("\"operation\":\"\(operation)\"") == true)
+            XCTAssertTrue(messages.last?.contains("\"code\":\(code)") == true)
+        }
+    }
+
+    func testEndWithoutActivationIsLoggedAndLateADelegateCannotGainBAttribution() {
+        var messages: [String] = []
+        let plugin = NfcProbePlugin()
+        plugin.diagnosticTrace = NfcDiagnosticTrace(now: { 12 }, sink: { messages.append($0) })
+
+        let first = startNdef(plugin, attemptId: "A")
+        wait(for: [first], timeout: 1)
+        let sessionA = try! XCTUnwrap(plugin.sessions.first)
+        plugin.onSessionQueue {
+            plugin.readerSession(
+                sessionA,
+                didInvalidateWithError: NSError(domain: NFCReaderError.errorDomain, code: 81)
+            )
+        }
+        XCTAssertTrue(messages.last?.contains("\"event\":\"ndef.ending\"") == true)
+        XCTAssertFalse(messages.contains { $0.contains("ndef.rf.active") })
+
+        let second = startNdef(plugin, attemptId: "B")
+        wait(for: [second], timeout: 1)
+        let sessionB = try! XCTUnwrap(plugin.sessions.last)
+        let countBeforeLateA = messages.count
+        plugin.onSessionQueue {
+            plugin.readerSessionDidBecomeActive(sessionA)
+            plugin.readerSession(
+                sessionA,
+                didInvalidateWithError: NSError(domain: NFCReaderError.errorDomain, code: 82)
+            )
+        }
+
+        XCTAssertEqual(messages.count, countBeforeLateA)
+        plugin.onSessionQueue {
+            plugin.readerSessionDidBecomeActive(sessionB)
+        }
+        XCTAssertTrue(messages.last?.contains("\"generation\":2") == true)
+        XCTAssertTrue(messages.last?.contains("\"event\":\"ndef.rf.active\"") == true)
+    }
+
+    func testRecordsOrderedNdefActivationWithoutAttemptIdentity() {
+        var messages: [String] = []
+        let trace = NfcDiagnosticTrace(
+            now: { 42.5 },
+            sink: { messages.append($0) }
+        )
+
+        trace.event("ndef.begin.initiated", generation: 7)
+        trace.event("ndef.rf.active", generation: 7)
+
+        XCTAssertEqual(messages.count, 2)
+        XCTAssertTrue(messages[0].contains("NFC_GATE_DIAGNOSTIC"))
+        XCTAssertTrue(messages[0].contains("\"event\":\"ndef.begin.initiated\""))
+        XCTAssertTrue(messages[1].contains("\"event\":\"ndef.rf.active\""))
+        XCTAssertTrue(messages[1].contains("\"generation\":7"))
+        XCTAssertTrue(messages[1].contains("\"processUptimeMs\":42500"))
+        XCTAssertFalse(messages.joined().contains("attempt"))
+    }
+
+    func testRedactsUnknownErrorDomainAndDescriptionWhileKeepingNumericCodeAndOperation() {
+        var message = ""
+        let trace = NfcDiagnosticTrace(now: { 3 }, sink: { message = $0 })
+        let error = NSError(
+            domain: "com.private.reader.secret",
+            code: 735,
+            userInfo: [NSLocalizedDescriptionKey: "tag uid 11:22:33"]
+        )
+
+        trace.error(operation: "read", generation: 4, error: error)
+
+        XCTAssertTrue(message.contains("\"event\":\"ndef.error\""))
+        XCTAssertTrue(message.contains("\"operation\":\"read\""))
+        XCTAssertTrue(message.contains("\"domainCategory\":\"unknown\""))
+        XCTAssertTrue(message.contains("\"code\":735"))
+        XCTAssertFalse(message.contains("com.private.reader.secret"))
+        XCTAssertFalse(message.contains("tag uid"))
+        XCTAssertFalse(message.contains("userInfo"))
+    }
+
+    func testClassifiesTheSdkNfcErrorDomainWithoutLoggingItsDomainText() {
+        var message = ""
+        let trace = NfcDiagnosticTrace(now: { 3 }, sink: { message = $0 })
+
+        trace.error(
+            operation: "connect",
+            generation: 4,
+            error: NSError(domain: NFCReaderError.errorDomain, code: 200)
+        )
+
+        XCTAssertTrue(message.contains("\"domainCategory\":\"core-nfc\""))
+        XCTAssertTrue(message.contains("\"code\":200"))
+        XCTAssertFalse(message.contains(NFCReaderError.errorDomain))
+    }
+}
