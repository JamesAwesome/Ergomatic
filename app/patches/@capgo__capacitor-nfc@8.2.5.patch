+        var state = NdefAttemptState()
+        XCTAssertThrowsError(try state.requestStart(attemptId: ""))
+        XCTAssertFalse(isExactlyOneDetectedTag(count: 0))
+        XCTAssertTrue(isExactlyOneDetectedTag(count: 1))
