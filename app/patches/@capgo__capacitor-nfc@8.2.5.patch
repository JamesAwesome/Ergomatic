new file mode 100644
index 0000000000000000000000000000000000000000..1f90da9c224281fb5054d117225cf6004466e647
--- /dev/null
+++ b/ios/Tests/NfcPluginTests/NfcPluginTestDoubles.swift
@@ -0,0 +1,188 @@
+import Capacitor
+import CoreNFC
+import Foundation
+import XCTest
+
+@testable import NfcPlugin
+
+/// A no-radio NDEF tag. Its completion handlers fire synchronously so a test
+/// can drive connect → query → read on the plugin's own session queue.
+@objc(NfcFakeNdefTag)
+final class NfcFakeNdefTag: NSObject, NFCNDEFTag {
+    static var supportsSecureCoding: Bool { true }
+    var isAvailable: Bool { true }
+    private let queryError: Error?
+    private let readError: Error?
+
+    required init?(coder: NSCoder) {
+        queryError = nil
+        readError = nil
+        super.init()
+    }
+
+    init(queryError: Error? = nil, readError: Error? = nil) {
+        self.queryError = queryError
+        self.readError = readError
+        super.init()
+    }
+
+    func encode(with coder: NSCoder) {}
+    func copy(with zone: NSZone? = nil) -> Any { self }
+    func queryNDEFStatus(completionHandler: @escaping (NFCNDEFStatus, Int, Error?) -> Void) {
+        completionHandler(.readWrite, 128, queryError)
+    }
+    func readNDEF(completionHandler: @escaping (NFCNDEFMessage?, Error?) -> Void) {
+        completionHandler(nil, readError)
+    }
+    func writeNDEF(_ ndefMessage: NFCNDEFMessage, completionHandler: @escaping (Error?) -> Void) {
+        completionHandler(nil)
+    }
+    func writeLock(completionHandler: @escaping (Error?) -> Void) {
+        completionHandler(nil)
+    }
+}
+
+/// A real `NFCNDEFReaderSession` subclass that never touches the radio. It
+/// records what the plugin asked of it; delivering delegate callbacks back into
+/// the plugin is the test's job (iOS is not in the loop).
+final class NfcFakeNdefSession: NFCNDEFReaderSession {
+    private(set) var connectCount = 0
+    private(set) var plainInvalidateCount = 0
+    private(set) var invalidationMessages: [String] = []
+    private var connectCompletion: ((Error?) -> Void)?
+
+    override func begin() {}
+
+    override func invalidate() {
+        plainInvalidateCount += 1
+    }
+
+    override func invalidate(errorMessage: String) {
+        invalidationMessages.append(errorMessage)
+    }
+
+    override func connect(
+        to tag: NFCNDEFTag,
+        completionHandler: @escaping (Error?) -> Void
+    ) {
+        connectCount += 1
+        connectCompletion = completionHandler
+    }
+
+    func finishConnect(_ error: Error?) {
+        connectCompletion?(error)
+    }
+}
+
+/// The production plugin with only its session factory replaced.
+final class NfcProbePlugin: NfcPlugin {
+    private(set) var sessions: [NfcFakeNdefSession] = []
+    private var callbackQueue: DispatchQueue?
+
+    override func makeNdefReaderSession(
+        delegate: NFCNDEFReaderSessionDelegate,
+        queue: DispatchQueue,
+        invalidateAfterFirstRead: Bool
+    ) -> NFCNDEFReaderSession {
+        callbackQueue = queue
+        let session = NfcFakeNdefSession(
+            delegate: delegate,
+            queue: queue,
+            invalidateAfterFirstRead: invalidateAfterFirstRead
+        )
+        sessions.append(session)
+        return session
+    }
+
+    /// Runs `operation` on the plugin's session queue, the queue Core NFC
+    /// would deliver delegate callbacks on, and returns when it has finished.
+    func onSessionQueue(_ operation: @escaping () -> Void) {
+        callbackQueue!.sync(execute: operation)
+    }
+}
+
+extension XCTestCase {
+    func startNdef(
+        _ plugin: NfcProbePlugin,
+        attemptId: String,
+        file: StaticString = #filePath,
+        line: UInt = #line
+    ) -> XCTestExpectation {
+        let resolved = expectation(description: "start \(attemptId) resolves")
+        let call = CAPPluginCall(
+            callbackId: attemptId,
+            methodName: "startScanning",
+            options: [:],
+            success: { _, _ in resolved.fulfill() },
+            error: { error in
+                XCTFail("unexpected start rejection: \(String(describing: error))", file: file, line: line)
+            }
+        )!
+        plugin.scheduleStart(
+            call: call,
+            attemptId: attemptId,
+            alertMessage: nil,
+            invalidateAfterFirstRead: false,
+            requestedKind: .ndef,
+            pollingOptions: []
+        )
+        return resolved
+    }
+
+    /// Issues `stopScanning` for `attemptId`. `settled` is fulfilled when the
+    /// call resolves; `isSettled()` reads the same fact without consuming the
+    /// expectation, so a test can assert "not yet" before waiting.
+    func stopNdef(
+        _ plugin: NfcPlugin,
+        attemptId: String,
+        file: StaticString = #filePath,
+        line: UInt = #line
+    ) -> (settled: XCTestExpectation, isSettled: () -> Bool) {
+        let settled = expectation(description: "stop \(attemptId) resolves")
+        final class Flag { var value = false }
+        let flag = Flag()
+        let call = CAPPluginCall(
+            callbackId: "stop-\(attemptId)",
+            methodName: "stopScanning",
+            options: ["attemptId": attemptId],
+            success: { _, _ in
+                flag.value = true
+                settled.fulfill()
+            },
+            error: { error in
+                XCTFail("unexpected stop rejection: \(String(describing: error))", file: file, line: line)
+            }
+        )!
+        plugin.stopScanning(call)
+        return (settled, { flag.value })
+    }
+
+    /// Subscribes to a plugin event the way the Capacitor bridge does, without
+    /// a bridge: the plugin's listener tables are created on demand and the
+    /// call's success handler receives every `notifyListeners` payload.
+    func listen(
+        _ plugin: NfcPlugin,
+        event: String,
+        receive: @escaping ([String: Any]) -> Void
+    ) {
+        if plugin.eventListeners == nil { plugin.eventListeners = NSMutableDictionary() }
+        if plugin.retainedEventArguments == nil { plugin.retainedEventArguments = NSMutableDictionary() }
+        let call = CAPPluginCall(
+            callbackId: "listen-\(event)-\(UUID().uuidString)",
+            methodName: "addListener",
+            options: ["eventName": event],
+            success: { result, _ in receive(result?.data ?? [:]) },
+            error: { error in XCTFail("listener rejected: \(String(describing: error))") }
+        )!
+        plugin.addListener(call)
+    }
+
+    /// The plugin publishes listener events with `DispatchQueue.main.async`.
+    /// Waiting on a main-queue turn enqueued after the delegate call proves
+    /// every event that call produced has been delivered (or never will be).
+    func settleMainQueue() {
+        let drained = expectation(description: "main queue drained")
+        DispatchQueue.main.async { drained.fulfill() }
+        wait(for: [drained], timeout: 1)
+    }
+}
