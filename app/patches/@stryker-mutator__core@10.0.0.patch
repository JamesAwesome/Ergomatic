@@ -0,0 +1,26 @@
+import { serialize } from './utils/string-utils.js';
+import { ParentMessageKind } from './child-proxy/message-protocol.js';
+// Repository-maintained opt-in policy. Absence preserves upstream behavior.
+export const ergomaticWorkerFailurePolicyVersion = 2;
+export class ErgomaticWorkerFailure extends Error {
+    constructor(error) {
+        const failure = error?.ergomaticNativeFailure ?? {
+            kind: 'runner-rejection', pid: null, exitCode: null, signal: null,
+            stdoutTail: '', stderrTail: '',
+        };
+        super(`Mutation worker failed (${failure.kind}); automatic recovery disabled: ${error?.message ?? String(error)}`);
+        this.name = 'ErgomaticWorkerFailure';
+        this.failure = Object.freeze(failure);
+    }
+}
+// Publish at the native worker event, not after Vitest's fulfilled error
+// result. In particular, a worker that dies during startup can leave Vitest
+// awaiting its handshake; the owning proxy must still observe the failure.
+export function reportErgomaticWorkerFailure(error) {
+    if (!process.send) throw error;
+    process.send(serialize({
+        kind: ParentMessageKind.ErgomaticWorkerFailure,
+        error: error.message,
+        failure: error.failure,
+    }));
+}
