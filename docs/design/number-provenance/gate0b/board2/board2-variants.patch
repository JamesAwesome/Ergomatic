+// "the pause is invisible" is measured on a production-shaped record
+// rather than asserted. Readouts through `process.stdout.write`
+// (TESTING.md §11).
+import { describe, expect, it, vi, afterEach } from "vitest";
+import fs from "node:fs";
+import { act, renderHook } from "@testing-library/react";
+import { parseRecording, type ParsedRecording } from "../monitor/transports/recording";
+import { createReplayTransport } from "../monitor/transports/replay";
+import { withLiveness } from "../monitor/transports/liveness";
+import { releasingSchedule } from "../test/statusSubscriptions";
+import { readCapture } from "../test/captures";
+
+const OUT = process.env.BOARD2_OUT ?? "/tmp/board2";
+
+const JUST_ROW_CAPTURE: ParsedRecording = parseRecording(
+  readCapture(
+    "walk-2026-08-31-justrow",
+    "just-row-pm5-recording-1788214688045.jsonl.gz",
+  ),
+);
+
+const FIXED_NOW = new Date("2026-08-31T09:00:00.000Z");
+
