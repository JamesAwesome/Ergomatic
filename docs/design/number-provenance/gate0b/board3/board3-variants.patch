+// ===== GATE 0B BOARD 3 PROTOTYPE — THROWAWAY, NEVER SHIPS =====
+// Three compositions for M4/M5, approved in substance 2026-09-19: the
+// saved row gains the logbook's own figures, so the number the rower saw
+// at the erg (Overall Distance) finally appears where the record is.
+//
+// The NUMBERS are real — the e2e capture seeds the exit-7 walk's own
+// work 500 m / 2:04 and rest 242 m / 2:00 — but the PLUMBING is faked
+// through the query string, because the board is about composition and
+// the real derivation is PR 4's job. `?board3=a|b|c`, `?rest=none` for
+// the interrupted variant (M5's dashes).
+type Board3 = "off" | "a" | "b" | "c";
+
+interface Board3Figures {
+  workMeters: number;
+  workTime: string;
+  restMeters: number | null;
+  restTime: string | null;
+  overallMeters: number | null;
+  overallTime: string | null;
+}
+
+function board3Mode(): { mode: Board3; figures: Board3Figures } {
+  const off = {
+    mode: "off" as const,
+    figures: {
+      workMeters: 0,
+      workTime: "",
+      restMeters: null,
+      restTime: null,
+      overallMeters: null,
+      overallTime: null,
+    },
+  };
+  if (typeof window === "undefined") return off;
+  const q = new URLSearchParams(window.location.search);
+  const raw = q.get("board3");
+  if (raw !== "a" && raw !== "b" && raw !== "c") return off;
+  // M5: an interrupted row whose rest the record declines to claim.
+  const known = q.get("rest") !== "none";
+  return {
+    mode: raw,
+    figures: {
+      workMeters: 500,
+      workTime: "2:04",
+      restMeters: known ? 242 : null,
+      restTime: known ? "2:00" : null,
+      overallMeters: known ? 742 : null,
+      overallTime: known ? "4:04" : null,
+    },
+  };
+}
+
+/** Treatments A and B: the logbook's own three rows, two columns. The
+ *  arithmetic is visible down each column (500 + 242 = 742), which is the
+ *  property RF7 asks for — a reader can check the headline against the
+ *  rows by eye. */
+function Board3Table({ figures }: { figures: Board3Figures }) {
+  const rows: [string, string, string][] = [
+    ["WORK", String(figures.workMeters), figures.workTime],
+    [
+      "REST",
+      figures.restMeters === null ? DASH : String(figures.restMeters),
+      figures.restTime ?? DASH,
+    ],
+    [
+      "OVERALL",
+      figures.overallMeters === null ? DASH : String(figures.overallMeters),
+      figures.overallTime ?? DASH,
+    ],
+  ];
+  return (
+    <table className="board3-table">
+      <thead>
+        <tr>
+          <td />
+          <th scope="col">DISTANCE</th>
+          <th scope="col">TIME</th>
+        </tr>
+      </thead>
+      <tbody>
+        {rows.map(([label, meters, time]) => (
+          <tr key={label}>
+            <th scope="row">{label}</th>
+            <td>{meters}</td>
+            <td>{time}</td>
+          </tr>
+        ))}
+      </tbody>
+    </table>
+  );
+}
+
+/** Treatment C: the prose line replaced by named figures on one line —
+ *  the smallest change that still carries every figure the logbook does. */
+function Board3Line({ figures }: { figures: Board3Figures }) {
+  const rest =
+    figures.restMeters === null
+      ? `REST ${DASH}`
+      : `REST ${figures.restMeters} m · ${figures.restTime}`;
+  const overall =
+    figures.overallMeters === null
+      ? `OVERALL ${DASH}`
+      : `OVERALL ${figures.overallMeters} m · ${figures.overallTime}`;
+  return <p className="board3-line">{`${rest}    ${overall}`}</p>;
+}
+// ===== END GATE 0B BOARD 3 PROTOTYPE =====
