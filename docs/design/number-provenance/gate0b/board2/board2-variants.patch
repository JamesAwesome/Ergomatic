+  lines.push(`rest-marked samples: ${rest}`);
+  const lastT = s[s.length - 1]!.t / 10;
+  lines.push(`domainX today: [0, ${lastT.toFixed(2)}] s`);
+  lines.push(`last d: ${(s[s.length - 1]!.d / 10).toFixed(1)} m`);
