index 0000000000000000000000000000000000000000..74eb1d168a4fe0e262428757953f1e22d989986f
--- /dev/null
+++ b/dist/src/ergomatic-pool.js
@@ -0,0 +1,55 @@
+import { ErgomaticWorkerFailure, reportErgomaticWorkerFailure } from '@stryker-mutator/core';
+
+// Keep Vitest's own isolated thread implementation and messaging. Only native
+// error/exit events latch a failure; ordinary assertion and mutant results
+// retain their upstream meaning. The latch lives for this runner's lifetime.
+export function ergomaticPool(ThreadsPoolWorker) {
+    let firstFailure;
+    class FailFastThreads extends ThreadsPoolWorker {
+        name = 'ergomatic-threads';
+        stopping = false;
+        async start() {
+            try {
+                await super.start();
+            } catch (error) {
+                this.fail(error, 'thread-error', null);
+                throw firstFailure;
+            }
+            this.on('error', error => this.fail(error, 'thread-error', null));
+            this.on('exit', code => this.fail(new Error(`Vitest thread exited unexpectedly (${code})`), 'thread-exit', code));
+        }
+        fail(error, kind, exitCode) {
+            if (this.stopping || firstFailure) return;
+            firstFailure = new ErgomaticWorkerFailure({
+                message: error.message,
+                ergomaticNativeFailure: {
+                    kind: error.code === 'ERR_WORKER_OUT_OF_MEMORY' ? 'allocation' : kind,
+                    // This PID hosts the thread; exitCode belongs to the
+                    // thread, not a claim that this process has exited.
+                    pid: process.pid, exitCode, signal: null,
+                    errorCode: typeof error.code === 'string' ? error.code : null,
+                    stdoutTail: '', stderrTail: '',
+                },
+            });
+            reportErgomaticWorkerFailure(firstFailure);
+        }
+        send(message) {
+            if (message.type === 'stop') this.stopping = true;
+            if (firstFailure && (message.type === 'run' || message.type === 'collect')) throw firstFailure;
+            super.send(message);
+        }
+        async stop() {
+            this.stopping = true;
+            await super.stop();
+        }
+    }
+    return {
+        name: 'ergomatic-threads',
+        createPoolWorker(options) {
+            // Vitest schedules again after a worker error. Refuse before
+            // construction, including another witness in this same run.
+            if (firstFailure) throw firstFailure;
+            return new FailFastThreads(options);
+        },
+    };
+}
