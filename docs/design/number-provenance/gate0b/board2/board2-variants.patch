+// BOARD 2 PROBE — THROWAWAY. Deleted before the board's PR.
+//
+// Produces the real stored series for two committed captures and measures
+// what the trace chart's x axis actually does with their rests, so board 2
+// argues from numbers rather than from the spec's prose.
+//
+// Readouts go through `process.stdout.write`: this is a `client` test and
+// jsdom owns `console` (CLAUDE.md, TESTING.md §11).
+import { describe, expect, it } from "vitest";
+import fs from "node:fs";
+import type { MonitorFrame } from "../../domain/monitor/types.js";
+import type { WorkoutProgram } from "../../domain/monitor/program.js";
+import { parseRecording } from "../monitor/transports/recording.js";
+import { createEventLog } from "../monitor/eventLog.js";
+import { createSubscribedDriver } from "../test/statusSubscriptions";
+import { createReplayTransport } from "../monitor/transports/replay.js";
+import { createSeriesRecorder } from "../monitor/seriesRecorder.js";
+import type { SeriesData } from "../monitor/seriesRecorder.js";
+import { readCapture } from "../test/captures";
+
+const OUT = process.env.BOARD2_OUT ?? "/tmp/board2";
+
+/** The driver's own `intervalComplete` actuals from the last
+ *  `loadCaptureFrames` call — candidate B needs each interval's stored
+ *  `restSeconds` (0x0037 offset 12, a READBACK per
+ *  `domain/monitor/types.ts`). */
+const capturedActuals: unknown[] = [];
+
+async function loadCaptureFrames(
+  walkDir: string,
+  file: string,
+  programOverride?: WorkoutProgram,
+): Promise<MonitorFrame[]> {
+  const text = readCapture(walkDir, file);
+  const parsed = parseRecording(text);
+  const program = programOverride ?? parsed.header.program;
+  if (!program) throw new Error(`no program on ${walkDir}/${file}`);
+  const replay = createReplayTransport(parsed);
+  const [dev] = await replay.transport.scan();
+  await replay.transport.connect(dev!.id);
+  const log = createEventLog();
+  const driver = createSubscribedDriver(replay.transport, log, {
+    deviceName: dev!.name,
+    now: () => replay.clock.now(),
+    schedule: (cb, ms) => replay.clock.schedule(cb, ms),
+  });
+  const frames: MonitorFrame[] = [];
+  const actuals: unknown[] = [];
+  driver.events((e) => {
+    if (e.kind === "frame") frames.push(e.frame);
+    if (e.kind === "intervalComplete") actuals.push(e.actual);
+  });
+  capturedActuals.length = 0;
+  const programPending = driver.program(program);
+  await replay.run();
+  await programPending;
+  capturedActuals.push(...actuals);
+  return frames;
+}
+
+
+/** Transcribed from `registerReplay.test.ts`'s own decode of this
+ *  recording's tx bytes (walk-2026-08-16 session 2). */
+const SESSION_2_PROGRAM: WorkoutProgram = {
+  intervals: [
+    { type: "work", kind: "distance", value: 100, targetSplit: null, displaySpm: null, restSeconds: 0 },
+    { type: "work", kind: "time", value: 60, targetSplit: 129, displaySpm: null, restSeconds: 30 },
+    { type: "work", kind: "time", value: 120, targetSplit: 129, displaySpm: null, restSeconds: 30 },
+    { type: "work", kind: "distance", value: 500, targetSplit: 129, displaySpm: null, restSeconds: 30 },
+    { type: "work", kind: "time", value: 60, targetSplit: 129, displaySpm: null, restSeconds: 0 },
+  ],
+};
