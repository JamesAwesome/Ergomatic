diff --git a/ios/Sources/NfcPlugin/NdefAttemptState.swift b/ios/Sources/NfcPlugin/NdefAttemptState.swift
new file mode 100644
index 0000000000000000000000000000000000000000..4f81938b3d1454cb4528b8351c1d4e6b343c44c9
--- /dev/null
+++ b/ios/Sources/NfcPlugin/NdefAttemptState.swift
@@ -0,0 +1,160 @@
+import Foundation
+
+enum NfcSessionKind: Equatable {
+    case ndef
+    case tag
+}
+
+struct NdefAttemptKey: Equatable {
+    let attemptId: String
+    let generation: UInt64
+    let sessionIdentifier: ObjectIdentifier
+    let kind: NfcSessionKind
+
+    init(
+        attemptId: String,
+        generation: UInt64,
+        sessionIdentifier: ObjectIdentifier,
+        kind: NfcSessionKind = .ndef
+    ) {
+        self.attemptId = attemptId
+        self.generation = generation
+        self.sessionIdentifier = sessionIdentifier
+        self.kind = kind
+    }
+}
+
+enum NdefStartDecision: Equatable {
+    case begin(String)
+    case invalidate(NdefAttemptKey)
+}
+
+enum NdefStopDecision: Equatable {
+    case invalidate(NdefAttemptKey)
+    case awaitInvalidation(NdefAttemptKey)
+    case cancelPending
+    case alreadyDrained
+}
+
+enum NdefAttemptStateError: Error {
+    case emptyAttemptId
+    case activationDoesNotMatchPendingStart
+}
+
+func isExactlyOneDetectedTag(count: Int) -> Bool { count == 1 }
+
+struct NdefAttemptState {
+    private(set) var nextGeneration: UInt64 = 0
+    private(set) var active: NdefAttemptKey?
+    private(set) var draining: NdefAttemptKey?
+    private(set) var beginCandidate: String?
+    private(set) var beginCandidateKind: NfcSessionKind?
+    private(set) var pendingAttemptId: String?
+    private(set) var pendingKind: NfcSessionKind?
+
+    mutating func requestStart(attemptId: String) throws -> NdefStartDecision {
+        try requestStart(attemptId: attemptId, kind: .ndef)
+    }
+
+    mutating func requestStart(attemptId: String, kind: NfcSessionKind) throws -> NdefStartDecision {
+        guard !attemptId.isEmpty else { throw NdefAttemptStateError.emptyAttemptId }
+        if let active {
+            pendingAttemptId = attemptId
+            pendingKind = kind
+            draining = active
+            self.active = nil
+            return .invalidate(active)
+        }
+        if let draining {
+            pendingAttemptId = attemptId
+            pendingKind = kind
+            return .invalidate(draining)
+        }
+        beginCandidate = attemptId
+        beginCandidateKind = kind
+        return .begin(attemptId)
+    }
+
+    mutating func activate(attemptId: String, session: AnyObject) throws -> NdefAttemptKey {
+        try activate(attemptId: attemptId, kind: .ndef, session: session)
+    }
+
+    mutating func activate(
+        attemptId: String,
+        kind: NfcSessionKind,
+        session: AnyObject
+    ) throws -> NdefAttemptKey {
+        guard beginCandidate == attemptId, beginCandidateKind == kind else {
+            throw NdefAttemptStateError.activationDoesNotMatchPendingStart
+        }
+        nextGeneration += 1
+        let key = NdefAttemptKey(
+            attemptId: attemptId,
+            generation: nextGeneration,
+            sessionIdentifier: ObjectIdentifier(session),
+            kind: kind
+        )
+        beginCandidate = nil
+        beginCandidateKind = nil
+        active = key
+        return key
+    }
+
+    func accepts(_ key: NdefAttemptKey) -> Bool { active == key && draining == nil }
+
+    mutating func replaceActiveSession(_ key: NdefAttemptKey, session: AnyObject) -> NdefAttemptKey? {
+        guard active == key, draining == nil else { return nil }
+        nextGeneration += 1
+        let replacement = NdefAttemptKey(
+            attemptId: key.attemptId,
+            generation: nextGeneration,
+            sessionIdentifier: ObjectIdentifier(session),
+            kind: key.kind
+        )
+        active = replacement
+        return replacement
+    }
+
+    mutating func requestStop(attemptId: String) -> NdefStopDecision {
+        if let active, active.attemptId == attemptId {
+            draining = active
+            self.active = nil
+            if pendingAttemptId == attemptId {
+                pendingAttemptId = nil
+                pendingKind = nil
+            }
+            return .invalidate(active)
+        }
+        if let draining, draining.attemptId == attemptId {
+            if pendingAttemptId == attemptId {
+                pendingAttemptId = nil
+                pendingKind = nil
+            }
+            return .awaitInvalidation(draining)
+        }
+        if pendingAttemptId == attemptId {
+            pendingAttemptId = nil
+            pendingKind = nil
+            return .cancelPending
+        }
+        if beginCandidate == attemptId {
+            beginCandidate = nil
+            beginCandidateKind = nil
+            return .cancelPending
+        }
+        return .alreadyDrained
+    }
+
+    mutating func finishInvalidation(_ key: NdefAttemptKey) -> String? {
+        guard draining == key else { return nil }
+        active = nil
+        draining = nil
+        let next = pendingAttemptId
+        pendingAttemptId = nil
+        let nextKind = pendingKind
+        pendingKind = nil
+        beginCandidate = next
+        beginCandidateKind = nextKind
+        return next
+    }
+}
