@@ -0,0 +1,190 @@
+import XCTest
+@testable import NfcPlugin
+
+final class NdefAttemptStateTests: XCTestCase {
+    func testCoordinatorSerializesConcurrentCrossTypeTransitions() {
+        let coordinator = NfcSessionCoordinator()
+        let ready = expectation(description: "all coordinator operations finish")
+        ready.expectedFulfillmentCount = 3
+        let stateLock = NSLock()
+        var completedOnCoordinator = [Bool]()
+
+        for index in 0..<3 {
+            DispatchQueue.global().async {
+                coordinator.async {
+                    let onCoordinator = coordinator.isCurrentContext
+                    stateLock.lock()
+                    completedOnCoordinator.append(onCoordinator)
+                    stateLock.unlock()
+                    guard onCoordinator else {
+                        ready.fulfill()
+                        return
+                    }
+
+                    let firstSession = NSObject()
+                    let secondSession = NSObject()
+                    let firstKind: NfcSessionKind = index.isMultiple(of: 2) ? .ndef : .tag
+                    let secondKind: NfcSessionKind = firstKind == .ndef ? .tag : .ndef
+                    let firstAttempt = "attempt-\(index)-a"
+                    let secondAttempt = "attempt-\(index)-b"
+                    XCTAssertEqual(
+                        try? coordinator.requestStart(attemptId: firstAttempt, kind: firstKind),
+                        .begin(firstAttempt)
+                    )
+                    let firstKey = try? coordinator.activate(
+                        attemptId: firstAttempt,
+                        kind: firstKind,
+                        session: firstSession
+                    )
+                    XCTAssertNotNil(firstKey)
+                    if let firstKey {
+                        XCTAssertEqual(
+                            try? coordinator.requestStart(attemptId: secondAttempt, kind: secondKind),
+                            .invalidate(firstKey)
+                        )
+                        XCTAssertEqual(coordinator.finishInvalidation(firstKey), secondAttempt)
+                        let secondKey = try? coordinator.activate(
+                            attemptId: secondAttempt,
+                            kind: secondKind,
+                            session: secondSession
+                        )
+                        XCTAssertNotNil(secondKey)
+                        if let secondKey {
+                            XCTAssertEqual(
+                                coordinator.requestStop(attemptId: secondAttempt),
+                                .invalidate(secondKey)
+                            )
+                            XCTAssertNil(coordinator.finishInvalidation(secondKey))
+                        }
+                    }
+                    ready.fulfill()
+                }
+            }
+        }
+
+        wait(for: [ready], timeout: 2)
+        XCTAssertEqual(completedOnCoordinator, [true, true, true])
+    }
+
+    func testBWaitsForAAndLateACannotClearB() throws {
+        let aSession = NSObject()
+        let bSession = NSObject()
+        var state = NdefAttemptState()
+
+        XCTAssertEqual(try state.requestStart(attemptId: "attempt-a"), .begin("attempt-a"))
+        let a = try state.activate(attemptId: "attempt-a", session: aSession)
+        XCTAssertTrue(state.accepts(a))
+
+        XCTAssertEqual(try state.requestStart(attemptId: "attempt-b"), .invalidate(a))
+        XCTAssertFalse(state.accepts(a))
+        XCTAssertEqual(state.finishInvalidation(a), "attempt-b")
+
+        let b = try state.activate(attemptId: "attempt-b", session: bSession)
+        XCTAssertTrue(state.accepts(b))
+        XCTAssertNil(state.finishInvalidation(a))
+        XCTAssertTrue(state.accepts(b))
+        XCTAssertEqual(state.requestStop(attemptId: "attempt-a"), .alreadyDrained)
+        XCTAssertTrue(state.accepts(b))
+    }
+
+    func testStopSettlesOnlyAfterMatchingInvalidation() throws {
+        let session = NSObject()
+        var state = NdefAttemptState()
+        XCTAssertEqual(try state.requestStart(attemptId: "attempt-a"), .begin("attempt-a"))
+        let a = try state.activate(attemptId: "attempt-a", session: session)
+
+        XCTAssertEqual(state.requestStop(attemptId: "attempt-a"), .invalidate(a))
+        XCTAssertFalse(state.accepts(a))
+        XCTAssertNil(state.finishInvalidation(
+            NdefAttemptKey(attemptId: "attempt-a", generation: a.generation + 1, sessionIdentifier: a.sessionIdentifier)
+        ))
+        XCTAssertEqual(state.finishInvalidation(a), nil)
+        XCTAssertEqual(state.requestStop(attemptId: "attempt-a"), .alreadyDrained)
+    }
+
+    func testStopCancelsBWhileBIsQueuedBehindA() throws {
+        let session = NSObject()
+        var state = NdefAttemptState()
+        XCTAssertEqual(try state.requestStart(attemptId: "attempt-a"), .begin("attempt-a"))
+        let a = try state.activate(attemptId: "attempt-a", session: session)
+        XCTAssertEqual(try state.requestStart(attemptId: "attempt-b"), .invalidate(a))
+
+        XCTAssertEqual(state.requestStop(attemptId: "attempt-b"), .cancelPending)
+        XCTAssertNil(state.finishInvalidation(a))
+    }
+
+    func testRejectsMissingAttemptIdAndNonSingletonTagCounts() {
+        var state = NdefAttemptState()
+        XCTAssertThrowsError(try state.requestStart(attemptId: ""))
+        XCTAssertFalse(isExactlyOneDetectedTag(count: 0))
+        XCTAssertTrue(isExactlyOneDetectedTag(count: 1))
+        XCTAssertFalse(isExactlyOneDetectedTag(count: 2))
+    }
+
+    func testTagStopKeepsOwnershipDrainingUntilItsMatchingInvalidation() throws {
+        let session = NSObject()
+        var state = NdefAttemptState()
+
+        XCTAssertEqual(try state.requestStart(attemptId: "tag-a", kind: .tag), .begin("tag-a"))
+        let tagA = try state.activate(attemptId: "tag-a", kind: .tag, session: session)
+        XCTAssertTrue(state.accepts(tagA))
+
+        XCTAssertEqual(state.requestStop(attemptId: "tag-a"), .invalidate(tagA))
+        XCTAssertFalse(state.accepts(tagA))
+        XCTAssertNil(state.finishInvalidation(
+            NdefAttemptKey(
+                attemptId: "tag-a",
+                generation: tagA.generation + 1,
+                sessionIdentifier: tagA.sessionIdentifier,
+                kind: .tag
+            )
+        ))
+        XCTAssertNil(state.finishInvalidation(tagA))
+        XCTAssertFalse(state.accepts(tagA))
+    }
+
+    func testLateTagInvalidationCannotClearTagReplacement() throws {
+        let aSession = NSObject()
+        let bSession = NSObject()
+        var state = NdefAttemptState()
+
+        XCTAssertEqual(try state.requestStart(attemptId: "tag-a", kind: .tag), .begin("tag-a"))
+        let tagA = try state.activate(attemptId: "tag-a", kind: .tag, session: aSession)
+        XCTAssertEqual(try state.requestStart(attemptId: "tag-b", kind: .tag), .invalidate(tagA))
+        XCTAssertEqual(state.finishInvalidation(tagA), "tag-b")
+
+        let tagB = try state.activate(attemptId: "tag-b", kind: .tag, session: bSession)
+        XCTAssertTrue(state.accepts(tagB))
+        XCTAssertNil(state.finishInvalidation(tagA))
+        XCTAssertTrue(state.accepts(tagB))
+    }
+
+    func testNdefStartQueuesBehindDrainingTagSession() throws {
+        let tagSession = NSObject()
+        let ndefSession = NSObject()
+        var state = NdefAttemptState()
+
+        XCTAssertEqual(try state.requestStart(attemptId: "tag-a", kind: .tag), .begin("tag-a"))
+        let tagA = try state.activate(attemptId: "tag-a", kind: .tag, session: tagSession)
+
+        XCTAssertEqual(try state.requestStart(attemptId: "ndef-b", kind: .ndef), .invalidate(tagA))
+        XCTAssertFalse(state.accepts(tagA))
+        XCTAssertEqual(state.finishInvalidation(tagA), "ndef-b")
+
+        let ndefB = try state.activate(attemptId: "ndef-b", kind: .ndef, session: ndefSession)
+        XCTAssertTrue(state.accepts(ndefB))
+    }
+
+    func testStopWithReusedAttemptIdWaitsForDrainingGeneration() throws {
+        let session = NSObject()
+        var state = NdefAttemptState()
+
+        XCTAssertEqual(try state.requestStart(attemptId: "attempt-a"), .begin("attempt-a"))
+        let a = try state.activate(attemptId: "attempt-a", session: session)
+        XCTAssertEqual(try state.requestStart(attemptId: "attempt-a"), .invalidate(a))
+
+        XCTAssertEqual(state.requestStop(attemptId: "attempt-a"), .awaitInvalidation(a))
+        XCTAssertNil(state.finishInvalidation(a))
+        XCTAssertEqual(state.requestStop(attemptId: "attempt-a"), .alreadyDrained)
+    }
+}
