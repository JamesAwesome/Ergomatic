@@ -0,0 +1,50 @@
+// BOARD 2 PROBE (axis geometry) — THROWAWAY.
+import { describe, expect, it } from "vitest";
+import fs from "node:fs";
+import { buildTrace, type AxisMode } from "./traceModel";
+import type { SeriesData } from "../monitor/seriesRecorder";
+
+const DIR = "../docs/design/number-provenance/gate0b/board2/fixtures";
+const CHART_WIDTH = 320;
+const LEFT_PAD = 28;
+const RIGHT_PAD = 8;
+
+const FIXTURES: { name: string; file: string; rest: number[] }[] = [
+  { name: "session-2 (three EQUAL 30 s rests)", file: "session2-series.json", rest: [30, 30, 30] },
+  { name: "rests-finished (two EQUAL 60 s rests)", file: "rests-finished-series.json", rest: [60, 60] },
+  { name: "work-clock (60.5 s mid-interval STOP)", file: "work-clock-series.json", rest: [] },
+  { name: "free row (104.6 s pause)", file: "justrow-series.json", rest: [] },
+];
+
+describe("board 2 axis geometry", () => {
+  it("measures every candidate against every fixture", () => {
+    const out: string[] = [];
+    for (const f of FIXTURES) {
+      const series = JSON.parse(
+        fs.readFileSync(`${DIR}/${f.file}`, "utf8"),
+      ) as SeriesData;
+      out.push(`\n===== ${f.name} =====`);
+      for (const mode of ["today", "work", "wall", "breaks"] as AxisMode[]) {
+        const t = buildTrace(series, "pace", mode, f.rest, 5);
+        if (t === null) {
+          out.push(`  ${mode}: NO TRACE`);
+          continue;
+        }
+        const plotW = CHART_WIDTH - LEFT_PAD - RIGHT_PAD;
+        const toX = (v: number) =>
+          LEFT_PAD + ((v - t.domainX[0]) / (t.domainX[1] - t.domainX[0])) * plotW;
+        const widths = t.spans.map(
+          (s) => `${(toX(s.endX) - toX(s.startX)).toFixed(2)}u/${s.seconds ?? "?"}s`,
+        );
+        out.push(
+          `  ${mode.padEnd(7)} domainX=[0, ${t.domainX[1].toFixed(1)}] ` +
+            `segments=${t.points.length} spans=${t.spans.length} [${widths.join(", ")}] ` +
+            `ticks=${t.ticksX.map((x) => x.label.toFixed(0)).join("/")} ` +
+            `stops=[${t.stops.map((x) => `${x.seconds.toFixed(1)}s`).join(", ")}]`,
+        );
+      }
+    }
+    process.stdout.write(`${out.join("\n")}\n`);
+    expect(out.length).toBeGreaterThan(0);
+  });
+});
