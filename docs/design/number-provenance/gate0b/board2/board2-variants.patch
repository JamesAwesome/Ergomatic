+    const replay = createReplayTransport(JUST_ROW_CAPTURE);
+    const transport = withLiveness(replay.transport, {
+      now: () => replay.clock.now(),
+      schedule: (fn, ms) => replay.clock.schedule(fn, ms),
+      onSilence: () => undefined,
+      onRecovery: () => undefined,
+    });
+    const apiFn = vi.fn<(path: string, init?: RequestInit) => Promise<Response>>(
+      async () => new Response(JSON.stringify({ id: "log-board2" })),
+    );
+    vi.doMock("../api", () => ({ api: apiFn }));
+    vi.resetModules();
+
+    const { useMonitorSession: freshUseMonitorSession } =
+      await import("../monitor/useMonitorSession");
+    const freshStore = await import("../monitor/handoffStore");
+
+    const { result } = renderHook(() =>
+      freshUseMonitorSession({
+        now: () => FIXED_NOW,
+        createTransport: () => transport,
+        registerAppLifecycleListener: () => (): void => undefined,
+        driverOptions: {
+          now: () => replay.clock.now(),
+          schedule: releasingSchedule((cb, ms) => replay.clock.schedule(cb, ms)),
+        },
+      }),
+    );
+
+    await act(async () => {
+      await result.current.connect();
+    });
+    act(() => {
+      result.current.beginFreeRow();
+    });
