new file mode 100644
index 0000000000000000000000000000000000000000..f12af2b17fa179813b9559b0158f13da082e4d2c
--- /dev/null
+++ b/ios/Sources/NfcPlugin/NfcDiagnosticTrace.swift
@@ -0,0 +1,69 @@
+import CoreNFC
+import Foundation
+
+#if DEBUG
+final class NfcDiagnosticTrace {
+    private let now: () -> TimeInterval
+    private let sink: (String) -> Void
+
+    init(
+        now: @escaping () -> TimeInterval = { ProcessInfo.processInfo.systemUptime },
+        sink: @escaping (String) -> Void = { print($0) }
+    ) {
+        self.now = now
+        self.sink = sink
+    }
+
+    func event(_ name: String, generation: UInt64, operation: String? = nil) {
+        emit(name: name, generation: generation, operation: operation, error: nil)
+    }
+
+    func ending(generation: UInt64, error: Error) {
+        emit(
+            name: "ndef.ending",
+            generation: generation,
+            operation: "session-end",
+            error: error
+        )
+    }
+
+    func error(operation: String, generation: UInt64, error: Error) {
+        emit(
+            name: "ndef.error",
+            generation: generation,
+            operation: operation,
+            error: error
+        )
+    }
+
+    private func emit(
+        name: String,
+        generation: UInt64,
+        operation: String?,
+        error: Error?
+    ) {
+        var value: [String: Any] = [
+            "event": name,
+            "generation": generation,
+            "processUptimeMs": Int(now() * 1_000)
+        ]
+        if let operation {
+            value["operation"] = operation
+        }
+        if let error {
+            let nsError = error as NSError
+            value["domainCategory"] = nsError.domain == NFCReaderError.errorDomain
+                ? "core-nfc"
+                : "unknown"
+            value["code"] = nsError.code
+        }
+        guard let data = try? JSONSerialization.data(
+            withJSONObject: value,
+            options: [.sortedKeys]
+        ), let payload = String(data: data, encoding: .utf8) else {
+            return
+        }
+        sink("NFC_GATE_DIAGNOSTIC \(payload)")
+    }
+}
+#endif
