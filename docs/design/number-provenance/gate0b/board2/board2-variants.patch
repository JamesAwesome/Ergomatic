+// GATE 0B CAPTURE HARNESS — board 2 (members M3, M6, M9).
+//
+// Renders the trace chart's FOUR x-axis treatments against THREE committed
+// captures, so the axis question is something James SEES rather than
+// something the spec asserts. Throwaway: deleted by the PR that implements
+// board 2's ruling, exactly as `gate0b.spec.ts` was.
+//
+// THE AXIS TREATMENTS come from a prototype patch that is NOT committed to
+// product code (`board2-variants.patch` beside the frames): `TraceChart`
+// reads `?axis=today|work|wall|breaks`, `?rest=<machine rest seconds>` and
+// `?stops=<seconds>` from the URL. `axis=today` is `main` unchanged.
+//
+// THE FIXTURES are real stored series, produced from committed wire
+// captures through the SHIPPED recorder (`fixtures/README.md` names the
+// probe): three equal 30 s rests, a 60.5 s mid-interval stop, and the free
+// row's 104.6 s pause.
+import fs from "node:fs";
+import path from "node:path";
+import { test, expect, type Page } from "@playwright/test";
+import { RUN_ID, signInViaBackdoor } from "./helpers";
+
+const BOARD = path.resolve(
+  process.cwd(),
+  "../docs/design/number-provenance/gate0b/board2",
+);
+const OUT = path.join(BOARD, process.env.BOARD2_OUT ?? "frames");
+const FIX = path.join(BOARD, "fixtures");
+
+interface Actual {
+  index: number;
+  elapsedSeconds: number;
+  distanceMeters: number;
+  avgSplit: number;
+  avgSpm: number;
+  avgHeartRateBpm: number | null;
+  restDistanceMeters: number;
+  restSeconds: number;
+  calories: number;
+  calPerHour: number;
+  watts: number;
+  dragFactor: number;
+}
+
+function readJson<T>(name: string): T {
+  return JSON.parse(fs.readFileSync(path.join(FIX, name), "utf8")) as T;
+}
+
+/** A log body shaped like the one the monitor doors post, built from the
+ *  capture's OWN actuals rather than invented numbers. */
+function bodyFor(opts: {
+  title: string;
+  seriesFile: string;
+  actualsFile: string | null;
+  freeRow: boolean;
+}): unknown {
+  // A free row has no intervals at all (`actuals: []`, proved on this very
+  // capture by `justRowReplay.test.ts`), so its totals come from 0x0039's
+  // own summary — the walk README's decode table, transcribed:
+  // 393.60 s / 1396.0 m, 25 spm, drag 101, average pace 140.9 s.
+  const FREE_ROW = {
+    workSeconds: 393.6,
+    workMeters: 1396,
+    avgSplit: 140.9,
+    avgSpm: 25,
+    drag: 101,
+  };
+  const series = readJson<{ samples: unknown[] }>(opts.seriesFile);
+  const actuals =
+    opts.actualsFile === null ? [] : readJson<Actual[]>(opts.actualsFile);
+  const steps = actuals.map((a) => ({
+    label: `${Math.round(a.distanceMeters)}m`,
+    // The capture's own programmed split (129 s/500m on both walks). The
+    // one value here NOT read off the wire: session-2's first interval is
+    // a 100 m warm-up whose program carries no target, and the log route
+    // requires a number, so it takes the same 129.
+    targetSplit: 129,
+    actualSplit: a.avgSplit,
+    actualSeconds: a.elapsedSeconds,
+    actualSource: "pm5",
+    meters: Math.round(a.distanceMeters),
+    actualMeters: Math.round(a.distanceMeters),
+    actualSpm: a.avgSpm,
+    machineCalories: a.calories,
+    machineCalPerHour: a.calPerHour,
+    machineWatts: a.watts,
+    machineDragFactor: a.dragFactor,
+    machineRestHr: null,
+    machineRestSeconds: a.restSeconds,
+    machineRestMeters: Math.round(a.restDistanceMeters),
+    ...(a.avgHeartRateBpm === null ? {} : { avgHr: a.avgHeartRateBpm }),
+  }));
+  const workSeconds = opts.freeRow
+    ? FREE_ROW.workSeconds
+    : actuals.reduce((n, a) => n + a.elapsedSeconds, 0);
+  const workMeters = opts.freeRow
+    ? FREE_ROW.workMeters
+    : actuals.reduce((n, a) => n + a.distanceMeters, 0);
+  const restSeconds = actuals.reduce((n, a) => n + a.restSeconds, 0);
+  const restMeters = actuals.reduce((n, a) => n + a.restDistanceMeters, 0);
+  return {
+    workoutId: null,
+    // A free row posts "Just Row" with a null id AND null type — the pair
+    // `isFreeRow` keys on (`src/justrow/JustRowLog.tsx:245`).
+    workoutTitle: opts.freeRow ? "Just Row" : opts.title,
+    workoutType: opts.freeRow ? null : "AT",
+    deviceName: "PM5 432331249",
+    source: "pm5",
+    held: "under",
+    effort: 3,
+    notes: null,
+    avgSplitSeconds:
+      workMeters > 0 ? (500 * workSeconds) / workMeters : null,
+    timeSeconds: Math.round(workSeconds + restSeconds),
+    distanceMeters: Math.round(workMeters + restMeters),
+    restSeconds: Math.round(restSeconds),
+    restMeters: Math.round(restMeters),
+    advancesPlan: false,
+    series,
+    steps,
+    machineWorkSeconds: workSeconds,
+    machineWorkMeters: Math.round(workMeters),
+    machineSummary: {
+      avgPaceSecondsPer500m:
+        workMeters > 0 ? (500 * workSeconds) / workMeters : 0,
+      avgStrokeRate: opts.freeRow
+        ? FREE_ROW.avgSpm
+        : actuals.length > 0
+          ? Math.round(
+              actuals.reduce((n, a) => n + a.avgSpm, 0) / actuals.length,
+            )
+          : 0,
+      dragFactorAverage: opts.freeRow
+        ? FREE_ROW.drag
+        : actuals.length > 0
+          ? Math.round(actuals[0]!.dragFactor)
+          : 0,
+      totalCalories: actuals.reduce((n, a) => n + a.calories, 0),
+      avgWatts:
+        actuals.length > 0
+          ? Math.round(
+              actuals.reduce((n, a) => n + a.watts, 0) / actuals.length,
+            )
+          : 0,
+      avgCalPerHour:
+        actuals.length > 0
+          ? Math.round(
+              actuals.reduce((n, a) => n + a.calPerHour, 0) / actuals.length,
+            )
+          : 0,
+      totalRestMeters: Math.round(restMeters),
+    },
+  };
+}
+
+const FIXTURES = [
+  {
+    key: "equal-rests",
+    title: "Three equal rests",
+    seriesFile: "session2-series.json",
+    actualsFile: "session2-actuals.json",
+    freeRow: false,
+    rest: "30,30,30",
+  },
+  {
+    key: "mid-stop",
+    title: "Stopped mid interval",
+    seriesFile: "work-clock-series.json",
+    actualsFile: "work-clock-actuals.json",
+    freeRow: false,
+    rest: "",
+  },
+  {
+    key: "free-row",
+    title: "Free row",
+    seriesFile: "justrow-series.json",
+    actualsFile: null,
+    freeRow: true,
+    rest: "",
+  },
+] as const;
+
+const AXES = ["today", "work", "wall", "breaks"] as const;
+
+async function seed(page: Page, body: unknown): Promise<string> {
+  return page.evaluate(async (b) => {
+    const res = await fetch("/api/logs", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(b),
+    });
+    const text = await res.text();
+    if (!res.ok) throw new Error(text);
+    return (JSON.parse(text) as { id: string }).id;
+  }, body);
+}
+
+for (const [orient, size] of [
+  ["portrait", { width: 390, height: 844 }],
+  ["landscape", { width: 844, height: 390 }],
+] as const) {
+  test(`gate 0B board 2: four axes over three captures, ${orient}`, async ({
+    page,
+  }) => {
+    test.setTimeout(300_000);
+    await page.setViewportSize(size);
+    await signInViaBackdoor(page, {
+      email: `gate0b2-${orient}-${RUN_ID}@e2e.test`,
+      name: "Gate 0B2",
+    });
+    fs.mkdirSync(OUT, { recursive: true });
+
+    const geometry: unknown[] = [];
+    for (const f of FIXTURES) {
+      await page.goto("/today");
+      const id = await seed(
+        page,
+        bodyFor({
+          title: f.title,
+          seriesFile: f.seriesFile,
+          actualsFile: f.actualsFile,
+          freeRow: f.freeRow,
+        }),
+      );
+      // The four candidates carry NO stop mark — `stops: "0"` is what the
+      // axis question is about on its own. The mark is a SEPARATE
+      // proposal and is captured after them, on the two fixtures that can
+      // tell whether it fires.
+      const passes: {
+        axis: (typeof AXES)[number];
+        stops: string;
+        mark: "fill" | "rules" | "band" | "gutter";
+        suffix: string;
+      }[] = [
+        ...AXES.map((axis) => ({
+          axis,
+          stops: "0",
+          mark: "fill" as const,
+          suffix: "",
+        })),
+        // Candidate C's break, drawn as two full-strength rules instead of
+        // a wash — the treatment the measured 1.36:1 forces onto the board
+        // (RF30: the option ruled out in a clause is the one that needs
+        // the receipt).
+        ...(f.key === "equal-rests"
+          ? [
+              {
+                axis: "breaks" as const,
+                stops: "0",
+                mark: "rules" as const,
+                suffix: "-rules",
+              },
+              // James ruled C with a BAND rather than rules (2026-09-19).
+              // Two band treatments that actually clear AA, since the
+              // 25 % wash does not.
+              {
+                axis: "breaks" as const,
+                stops: "0",
+                mark: "band" as const,
+                suffix: "-band",
+              },
+              {
+                axis: "breaks" as const,
+                stops: "0",
+                mark: "gutter" as const,
+                suffix: "-gutter",
+              },
+            ]
+          : []),
+        ...(f.key === "mid-stop" || f.key === "free-row"
+          ? [
+              {
+                axis: "today" as const,
+                stops: "5",
+                mark: "fill" as const,
+                suffix: "-stopmark",
+              },
+              {
+                axis: "today" as const,
+                stops: "5",
+                mark: "rules" as const,
+                suffix: "-stopmark-rules",
+              },
+              {
+                axis: "today" as const,
+                stops: "5",
+                mark: "band" as const,
+                suffix: "-stopmark-band",
+              },
+            ]
+          : []),
+      ];
+      for (const pass of passes) {
+        const axis = `${pass.axis}${pass.suffix}`;
+        const q = new URLSearchParams({
+          axis: pass.axis,
+          stops: pass.stops,
+          mark: pass.mark,
+        });
+        if (f.rest !== "") q.set("rest", f.rest);
+        await page.goto(`/today/log/${id}?${q.toString()}`);
+        const figure = page.locator(".trace-figure");
+        await expect(figure).toBeVisible();
+        await page.evaluate(() => document.fonts.ready);
+        await figure.scrollIntoViewIfNeeded();
+        await figure.screenshot({
+          path: path.join(OUT, `${f.key}-${axis}-${orient}.png`),
+        });
+        // The chart with the block that names its quantity, in one frame
+        // (M3: the axis sits directly under MACHINE CONFIRMED · WORK ONLY).
+        const block = page.locator(".log-machine-confirmed");
+        if ((await block.count()) > 0) {
+          const a = await block.boundingBox();
+          const b = await figure.boundingBox();
+          if (a !== null && b !== null) {
+            await page.screenshot({
+              path: path.join(OUT, `${f.key}-${axis}-${orient}-in-context.png`),
+              clip: {
+                x: Math.min(a.x, b.x),
+                y: a.y,
+                width: Math.max(a.width, b.width),
+                height: b.y + b.height - a.y,
+              },
+            });
+          }
+        }
+        geometry.push(
+          await page.evaluate(
+            ({ key, axisMode, orientation }) => {
+              const svg = document.querySelector(".trace-svg");
+              const vb = svg?.getAttribute("viewBox") ?? "";
+              const bands = Array.from(
+                document.querySelectorAll(".trace-rest-band"),
+              ).map((r) => ({
+                x: Number(r.getAttribute("x")),
+                width: Number(r.getAttribute("width")),
+                height: Number(r.getAttribute("height")),
+              }));
+              const stops = Array.from(
+                document.querySelectorAll(".trace-stop-span"),
+              ).map((r) => ({
+                x: Number(r.getAttribute("x")),
+                width: Number(r.getAttribute("width")),
+              }));
+              const lines = Array.from(
+                document.querySelectorAll("polyline.trace-line"),
+              ).length;
+              const ticks = Array.from(
+                document.querySelectorAll('[data-testid="trace-x-tick"]'),
+              ).map((t) => t.textContent);
+              const legend =
+                document.querySelector(".trace-legend")?.textContent ?? null;
+              const texts = Array.from(
+                document.querySelectorAll(".trace-svg text"),
+              ).map((t) => t.textContent);
+              return {
+                key,
+                axis: axisMode,
+                orientation,
+                viewBox: vb,
+                polylines: lines,
+                bands,
+                stops,
+                ticks,
+                legend,
+                texts,
+              };
+            },
+            { key: f.key, axisMode: axis, orientation: orient },
+          ),
+        );
+      }
+    }
+    fs.writeFileSync(
+      path.join(OUT, `geometry-${orient}.json`),
+      `${JSON.stringify(geometry, null, 2)}\n`,
+    );
+    process.stdout.write(`${JSON.stringify(geometry, null, 2)}\n`);
+  });
+}
+
+// Every colour pairing board 2 introduces, measured from the LIVE cascade
+// (RF6: the number goes in the report, never an eye). The two new marks sit
+// on TRANSLUCENT fills, so each is composited over the first opaque
+// background behind it before the ratio is taken — a ratio against the raw
+// token would be a different, easier question than the one on screen.
+test("gate 0B board 2: contrast", async ({ page }) => {
+  test.setTimeout(300_000);
+  await signInViaBackdoor(page, {
+    email: `gate0b2-contrast-${RUN_ID}@e2e.test`,
+    name: "Gate 0B2",
+  });
+  await page.goto("/today");
+  const id = await seed(
+    page,
+    bodyFor({
+      title: "Three equal rests",
+      seriesFile: "session2-series.json",
+      actualsFile: "session2-actuals.json",
+      freeRow: false,
+    }),
+  );
+  await page.goto(`/today/log/${id}?axis=breaks&rest=30,30,30&stops=5`);
+  await expect(page.locator(".trace-figure")).toBeVisible();
+  const measure = () => {
+    const parse = (c: string): [number, number, number, number] => {
+      const m = /rgba?\(([^)]+)\)/.exec(c);
+      if (m === null) return [0, 0, 0, 1];
+      const p = m[1]!.split(",").map((v) => parseFloat(v));
+      return [p[0]!, p[1]!, p[2]!, p[3] ?? 1];
+    };
+    const lum = ([r, g, b]: number[]) => {
+      const f = (v: number) => {
+        const s = v! / 255;
+        return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
+      };
+      return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);
+    };
+    const over = (
+      fg: [number, number, number, number],
+      bg: [number, number, number, number],
+    ): [number, number, number, number] => [
+      fg[0] * fg[3] + bg[0] * (1 - fg[3]),
+      fg[1] * fg[3] + bg[1] * (1 - fg[3]),
+      fg[2] * fg[3] + bg[2] * (1 - fg[3]),
+      1,
+    ];
+    const ratio = (a: number[], b: number[]) => {
+      const [l1, l2] = [lum(a), lum(b)].sort((x, y) => y - x);
+      return Number(((l1! + 0.05) / (l2! + 0.05)).toFixed(2));
+    };
+    const opaqueBehind = (el: Element): [number, number, number, number] => {
+      let n: Element | null = el;
+      while (n !== null) {
+        const c = parse(getComputedStyle(n).backgroundColor);
+        if (c[3] === 1) return c;
+        n = n.parentElement;
+      }
+      return parse(getComputedStyle(document.body).backgroundColor);
+    };
+    const out: unknown[] = [];
+    const page = opaqueBehind(document.querySelector(".trace-figure")!);
+
+    // Plain text on the page.
+    for (const sel of [
+      ".trace-legend",
+      ".trace-tick-label-y",
+      ".trace-tick-label-x",
+    ]) {
+      const el = document.querySelector(sel);
+      if (el === null) {
+        out.push({ element: sel, MISSING: true });
+        continue;
+      }
+      const st = getComputedStyle(el);
+      out.push({
+        element: sel,
+        sample: (el.textContent ?? "").slice(0, 12),
+        fg: st.color,
+        bg: `rgb(${page.slice(0, 3).map(Math.round).join(", ")})`,
+        fontPx: st.fontSize,
+        ratio: ratio(parse(st.color), page),
+      });
+    }
+    // The legend's swatch — a graphical object standing in for the word
+    // BAND, so it carries meaning and is held to 1.4.11's 3:1.
+    const swatch = document.querySelector(".trace-legend-swatch");
+    if (swatch === null) {
+      out.push({ element: ".trace-legend-swatch", MISSING: true });
+    } else {
+      const ss = getComputedStyle(swatch);
+      out.push({
+        element: ".trace-legend-swatch",
+        fill: ss.backgroundColor,
+        size: `${ss.width} x ${ss.height}`,
+        vsPage: ratio(parse(ss.backgroundColor), page),
+      });
+    }
+    // The two marks: fill vs page (a graphical object, AA 3:1), and the
+    // label sitting ON that composited fill (text, AA 4.5:1).
+    for (const [sel, label] of [
+      [".trace-rest-band", "break fill"],
+      [".trace-stop-span", "stop fill"],
+    ] as const) {
+      const rect = document.querySelector(sel);
+      if (rect === null) {
+        out.push({ element: sel, MISSING: true });
+        continue;
+      }
+      const st = getComputedStyle(rect);
+      // A rules treatment paints with `stroke`, a wash with `fill`.
+      const isRule = rect.tagName.toLowerCase() === "line";
+      const fill = parse(isRule ? st.stroke : st.fill);
+      const alpha = Number(rect.getAttribute("opacity") ?? st.opacity ?? "1");
+      const composited = over(
+        [fill[0], fill[1], fill[2], alpha * (fill[3] || 1)],
+        page,
+      );
+      out.push({
+        element: `${sel} (${label}, ${isRule ? "rules" : "wash"})`,
+        fill: isRule ? st.stroke : st.fill,
+        opacity: alpha,
+        composited: `rgb(${composited.slice(0, 3).map(Math.round).join(", ")})`,
+        vsPage: ratio(composited, page),
+      });
+      // The text drawn inside it.
+      const text = rect.parentElement?.querySelector("text");
+      if (text !== null && text !== undefined) {
+        const ts = getComputedStyle(text);
+        // The label is only ON the mark when the mark actually sits
+        // behind it. Under RULES the mark is a zero-width line, and under
+        // the GUTTER treatment it is a short bar below the plot while the
+        // label sits at the plot's top — in both the background is the
+        // page, and compositing over the mark would measure a background
+        // the text never has.
+        const markBox = rect.getBoundingClientRect();
+        const textBox = text.getBoundingClientRect();
+        const onTheMark =
+          !isRule &&
+          textBox.top >= markBox.top - 1 &&
+          textBox.bottom <= markBox.bottom + 1;
+        const behind = onTheMark ? composited : page;
+        out.push({
+          element: `${sel} label (on ${onTheMark ? "the mark" : "the page"})`,
+          sample: text.textContent,
+          fg: ts.color,
+          fontPx: ts.fontSize,
+          bg: `rgb(${behind.slice(0, 3).map(Math.round).join(", ")})`,
+          ratio: ratio(parse(ts.color), behind),
+        });
+      }
+    }
+    // The line itself, over the break fill it now crosses nothing of.
+    const line = document.querySelector("polyline.trace-line");
+    if (line !== null) {
+      const ls = getComputedStyle(line);
+      out.push({
+        element: "polyline.trace-line",
+        stroke: ls.stroke,
+        ratio: ratio(parse(ls.stroke), page),
+      });
+    }
+    return out;
+  };
+  const rows = await page.evaluate(measure);
+  await page.goto(
+    `/today/log/${id}?axis=breaks&rest=30,30,30&stops=5&mark=rules`,
+  );
+  await expect(page.locator(".trace-figure")).toBeVisible();
+  const ruleRows = (await page.evaluate(measure)) as { element: string }[];
+  // James ruled C with a band (2026-09-19). Both band treatments that
+  // clear AA, measured from the live cascade rather than computed.
+  await page.goto(
+    `/today/log/${id}?axis=breaks&rest=30,30,30&stops=5&mark=band&alpha=0.83`,
+  );
+  await expect(page.locator(".trace-figure")).toBeVisible();
+  const bandRows = (await page.evaluate(measure)) as { element: string }[];
+  await page.goto(
+    `/today/log/${id}?axis=breaks&rest=30,30,30&stops=5&mark=gutter`,
+  );
+  await expect(page.locator(".trace-figure")).toBeVisible();
+  const gutterRows = (await page.evaluate(measure)) as { element: string }[];
+  // The stop mark does not exist on a fixture with no stop, so it is
+  // measured on the capture that HAS one — the same run, a second row.
+  const stopId = await seed(
+    page,
+    bodyFor({
+      title: "Stopped mid interval",
+      seriesFile: "work-clock-series.json",
+      actualsFile: "work-clock-actuals.json",
+      freeRow: false,
+    }),
+  );
+  await page.goto(`/today/log/${stopId}?axis=today&stops=5`);
+  // ATTACHED, not visible: the rules treatment paints a zero-width
+  // `<line>`, which has no bounding box and so is "hidden" to Playwright
+  // however plainly it is on screen.
+  await expect(page.locator(".trace-stop-span").first()).toBeAttached();
+  const stopRows = (await page.evaluate(measure)) as { element: string }[];
+  await page.goto(`/today/log/${stopId}?axis=today&stops=5&mark=band`);
+  await expect(page.locator(".trace-stop-span").first()).toBeAttached();
+  const stopBandRows = (await page.evaluate(measure)) as { element: string }[];
+  await page.goto(`/today/log/${stopId}?axis=today&stops=5&mark=rules`);
+  // ATTACHED, not visible: the rules treatment paints a zero-width
+  // `<line>`, which has no bounding box and so is "hidden" to Playwright
+  // however plainly it is on screen.
+  await expect(page.locator(".trace-stop-span").first()).toBeAttached();
+  const stopRuleRows = (await page.evaluate(measure)) as { element: string }[];
+  const all = [
+    ...(rows as { element: string; MISSING?: boolean }[]).filter(
+      (r) => !r.element.startsWith(".trace-stop-span"),
+    ),
+    ...ruleRows
+      .filter((r) => r.element.startsWith(".trace-rest-band"))
+      .map((r) => ({ ...r, treatment: "rules" })),
+    ...bandRows
+      .filter((r) => r.element.startsWith(".trace-rest-band"))
