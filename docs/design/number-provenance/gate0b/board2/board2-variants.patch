+    fs.writeFileSync(`${OUT}/session2-actuals.json`, `${JSON.stringify(capturedActuals, null, 2)}\n`);
+    expect(series.samples.length).toBeGreaterThan(0);
+  }, 180_000);
+
+  it("work-clock walk: a programmed interval with a 60.5 s mid-interval STOP", async () => {
+    const frames = await loadCaptureFrames(
+      "walk-2026-09-15-work-clock",
