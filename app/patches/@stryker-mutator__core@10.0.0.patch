index 0000000000000000000000000000000000000000..fa74172d824fedcb3ff1f0acf7c0f23279b661d0
--- /dev/null
+++ b/dist/src/ergomatic-worker-failure.js
@@ -0,0 +1,13 @@
+// Repository-maintained opt-in policy. Absence preserves upstream behavior.
+export const ergomaticWorkerFailurePolicyVersion = 1;
+export class ErgomaticWorkerFailure extends Error {
+    constructor(error) {
+        const failure = error?.ergomaticNativeFailure ?? {
+            kind: 'runner-rejection', pid: null, exitCode: null, signal: null,
+            stdoutTail: '', stderrTail: '',
+        };
+        super(`Mutation worker failed (${failure.kind}); automatic recovery disabled: ${error?.message ?? String(error)}`);
+        this.name = 'ErgomaticWorkerFailure';
+        this.failure = Object.freeze(failure);
+    }
+}
